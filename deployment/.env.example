# Public host names. nginx-proxy routes them to the apps, acme-companion requests a Let's Encrypt certificate for each.
DOMAIN=rack.spicelang.com
STAGING_DOMAIN=staging.rack.spicelang.com

# Contact address for Let's Encrypt (optional, passed to acme-companion)
LETSENCRYPT_EMAIL=

# MySQL (one server, databases `rack` and `rack_staging`)
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me

# GitHub OAuth apps (https://github.com/settings/developers -> New OAuth App), one per environment
#   Authorization callback URL: https://<domain>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STAGING_GITHUB_CLIENT_ID=
STAGING_GITHUB_CLIENT_SECRET=

# Optional: a GitHub token without any scopes. It only raises the API rate limit of the background sync (60 -> 5000/hour).
GITHUB_TOKEN=

# Comma separated GitHub logins that are administrators (both environments). Applied at sign-in.
ADMIN_LOGINS=your-github-login

# Minutes between background syncs of stale packages
SYNC_INTERVAL_MINUTES=15
