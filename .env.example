# Public host name. Point its DNS record at the server, then run scripts/init-tls.sh once.
# DOMAIN=localhost creates a self-signed certificate for local use.
DOMAIN=rack.spicelang.com

# MySQL
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me

# GitHub OAuth apps (https://github.com/settings/developers -> New OAuth App)
#   Authorization callback URL: https://<domain>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: a GitHub token without any scopes. It only raises the API rate limit of the background sync (60 -> 5000/hour).
GITHUB_TOKEN=

# Comma separated GitHub logins that are administrators. Applied at sign-in.
ADMIN_LOGINS=your-github-login

# Minutes between background syncs of stale packages
SYNC_INTERVAL_MINUTES=15
