# Public host name; scripts/init-tls.sh requests a Let's Encrypt certificate for it (use localhost for a self-signed one)
DOMAIN=rack.spicelang.com

# Contact address for Let's Encrypt expiry notices (optional)
LETSENCRYPT_EMAIL=

# MySQL
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me

# GitHub OAuth app (https://github.com/settings/developers -> New OAuth App)
#   Homepage URL:               https://rack.spicelang.com
#   Authorization callback URL: https://rack.spicelang.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: a GitHub token without any scopes. It only raises the API rate limit of the background sync (60 -> 5000/hour).
GITHUB_TOKEN=

# Comma separated GitHub logins that are administrators. Applied at sign-in.
ADMIN_LOGINS=your-github-login

# Minutes between background syncs of stale packages (README, releases, dependencies, stars)
SYNC_INTERVAL_MINUTES=15
