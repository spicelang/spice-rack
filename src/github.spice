import "std/data/vector";
import "std/text/toml/toml-value";
import "std/text/toml/toml-parser";
import "./util";
import "./json";
import "./semver";
import "./core";

// ---------------------------------------------------------------------------------------------------------------------
// GitHub integration: OAuth helpers and the synchronisation of package metadata, README, releases and dependencies.
//
// A sync consists of three effect batches, which handlers place at consecutive steps (see the *Batch functions):
//   1. fetch   repository info, README (rendered HTML) and releases (rendered HTML), 3 requests per package
//   2. manifests   the `spice.toml` of the newest releases (declares dependencies)
//   3. write   one transaction that stores everything
//
// A package lives at the root of its repository or in a subdirectory (`path`), so that one repository can hold several
// packages. The releases of a package in a subdirectory are the ones whose tag names the directory, see `tagVersionPart`.
// ---------------------------------------------------------------------------------------------------------------------

public const string GITHUB_API = "https://api.github.com";
public const string MANIFEST_FILE = "spice.toml";
const unsigned long MAX_RELEASES = 30l;
// The releases of a repository with several packages are shared by all of them, so more are fetched to find 30 of one package
const unsigned long RELEASES_PER_PAGE = 30l;
const unsigned long SHARED_RELEASES_PER_PAGE = 100l;
const unsigned long MAX_MANIFESTS = 10l;
const unsigned long MAX_README_BYTES = 1500000l;

public type SyncJob struct {
    public long packageId = 0l
    public String owner
    public String repo
    public String path // Directory of the package in the repository, empty for the root
}

public type Release struct {
    public String tag
    public String version
    public String title
    public String body
    public String bodyHtml
    public bool prerelease = false
    public String publishedAt
    public String tarballUrl
}

public type Dependency struct {
    public String name
    public String constraint
    public bool dev = false
}

// ---------------------------------------------------------------------------------------------------------------------
// OAuth
// ---------------------------------------------------------------------------------------------------------------------

public f<String> githubAuthorizeUrl(const Ctx& ctx, const String& state) {
    return String("https://github.com/login/oauth/authorize?client_id=") + urlEncode(ctx.config.githubClientId) +
           "&scope=read:user&allow_signup=true&state=" + state +
           "&redirect_uri=" + urlEncode(ctx.config.baseUrl + "/auth/github/callback");
}

public f<String> githubTokenRequestBody(const Ctx& ctx, const String& code) {
    JsonWriter w;
    w.beginObject();
    w.kStr("client_id", ctx.config.githubClientId);
    w.kStr("client_secret", ctx.config.githubClientSecret);
    w.kStr("code", code);
    w.kStr("redirect_uri", ctx.config.baseUrl + "/auth/github/callback");
    w.endObject();
    return w.finish();
}

// ---------------------------------------------------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------------------------------------------------

/**
 * "2026-10-12T19:43:11Z" -> "2026-10-12 19:43:11"
 */
public f<String> toDbTime(const String& iso, const String& fallback) {
    if iso.getLength() < 19l || iso[10l] != 'T' { return fallback; }
    return iso.getSubstring(0l, 10l) + " " + iso.getSubstring(11l, 8l);
}

public f<String> repoApiUrl(const String& owner, const String& repo) {
    return String(GITHUB_API) + "/repos/" + urlEncode(owner) + "/" + urlEncode(repo);
}

/**
 * "packages/github" -> "packages/github/", "" -> ""
 */
f<String> dirPrefix(const String& path) {
    if path.isEmpty() { return String(""); }
    return path + "/";
}

/**
 * The rest of `tag` after `prefix` and one of the separators '/', '-' and '@', or the empty string if it does not start so
 */
f<String> versionAfterPrefix(const String& tag, const String& prefix) {
    const unsigned long len = prefix.getLength();
    if tag.getLength() <= len + 1l || head(tag, len) != prefix { return String(""); }
    const char separator = tag[len];
    if separator != '/' && separator != '-' && separator != '@' { return String(""); }
    return tail(tag, len + 1l);
}

/**
 * The part of a release tag that holds the version. Tags of a package at the repository root are versions themselves
 * ("v1.2.0"). Tags of a package in a subdirectory start with the directory, as full path or only its last segment, and one
 * of '/', '-' and '@': "github-v1.2.0", "github/v1.2.0", "github@1.2.0", "packages/github/v1.2.0". For tags of other
 * packages of the repository the result is empty.
 */
public f<String> tagVersionPart(const String& tag, const String& path) {
    if path.isEmpty() { return tag; }
    const String afterPath = versionAfterPrefix(tag, path);
    if !afterPath.isEmpty() { return afterPath; }
    return versionAfterPrefix(tag, lastPathSegment(path));
}

/**
 * Whether `text` contains `needle` at offset `at` (no temporary strings, README files can be large)
 */
f<bool> matchesAt(const String& text, unsigned long at, string needle) {
    const unsigned long needleLen = getRawLength(needle);
    if at + needleLen > text.getLength() { return false; }
    for unsigned long i = 0l; i < needleLen; i++ {
        if text[at + i] != needle[i] { return false; }
    }
    return true;
}

/**
 * GitHub renders relative links of a README relative to the repository. On the registry they have to point back
 * to GitHub: images to the raw files, everything else to the file view. Relative links of a README in a subdirectory
 * (`path`) start there, links with a leading '/' at the repository root.
 */
public f<String> rewriteRelativeLinks(const String& html, const String& owner, const String& repo, const String& path) {
    const String rawBase = String("https://raw.githubusercontent.com/") + owner + "/" + repo + "/HEAD/";
    const String blobBase = String("https://github.com/") + owner + "/" + repo + "/blob/HEAD/";
    const String dir = dirPrefix(path);
    String out;
    out.reserve(html.getLength() + 64l);
    const unsigned long len = html.getLength();
    unsigned long i = 0l;
    while i < len {
        const bool boundary = i == 0l || html[i - 1l] == ' ';
        const bool isSrc = boundary && matchesAt(html, i, "src=\"");
        const bool isHref = boundary && !isSrc && matchesAt(html, i, "href=\"");
        if isSrc || isHref {
            const unsigned long attrLen = isSrc ? 5l : 6l;
            const long close = html.find('"', i + attrLen);
            if close < 0l { break; }
            const unsigned long valueStart = i + attrLen;
            const unsigned long valueLen = cast<unsigned long>(close) - valueStart;
            const bool absolute = valueLen == 0l || html[valueStart] == '#' || matchesAt(html, valueStart, "http://") ||
                                  matchesAt(html, valueStart, "https://") || matchesAt(html, valueStart, "mailto:") ||
                                  matchesAt(html, valueStart, "data:") || matchesAt(html, valueStart, "//");
            // Copy the attribute name and the opening quote
            for unsigned long k = i; k < valueStart; k++ { out.append(html[k]); }
            unsigned long from = valueStart;
            if !absolute {
                out += isSrc ? rawBase : blobBase;
                if html[from] != '/' { out += dir; }
                while from < cast<unsigned long>(close) && html[from] == '/' { from++; }
                if matchesAt(html, from, "./") { from += 2l; }
            }
            for unsigned long k = from; k < cast<unsigned long>(close); k++ { out.append(html[k]); }
            i = cast<unsigned long>(close);
            continue;
        }
        out.append(html[i]);
        i++;
    }
    return out;
}

/**
 * Releases of a repository as returned by the releases API. Drafts, tags that are not semantic versions and, for a package
 * in a subdirectory (`path`), the releases of other packages are skipped.
 */
public f<Vector<Release>> parseReleases(JV releases, const String& owner, const String& repo, const String& path) {
    Vector<Release> list;
    for JV item = releases.first(); item.exists() && list.getSize() < MAX_RELEASES; item = item.after() {
        if item.getBool("draft") { continue; }
        Release release;
        release.tag = item.getStr("tag_name");
        const Semver parsed = parseSemver(tagVersionPart(release.tag, path));
        if !parsed.valid { continue; }
        release.version = parsed.toString();
        release.title = item.getStr("name");
        release.body = item.getStr("body");
        release.bodyHtml = item.getStr("body_html");
        release.prerelease = item.getBool("prerelease") || !parsed.pre.isEmpty();
        release.publishedAt = toDbTime(item.getStr("published_at"), toDbTime(item.getStr("created_at"), String("1970-01-01 00:00:00")));
        release.tarballUrl = String("https://github.com/") + owner + "/" + repo + "/archive/refs/tags/" + urlEncode(release.tag) + ".tar.gz";
        // The same version may appear twice (e.g. "v1.0.0" and "1.0.0"); the first, newest one wins
        bool duplicate = false;
        for unsigned long k = 0l; k < list.getSize(); k++ {
            if list.get(k).version == release.version { duplicate = true; }
        }
        if !duplicate { list.pushBack(release); }
    }
    return list;
}

/**
 * Registry dependencies declared in a spice.toml manifest (see the manifest spec of Spice Shaker):
 *   [dependencies]
 *   other-package = "^1.2.0"
 *   another = { version = "~2.0" }
 *   [dev-dependencies]
 *   ...
 * GitHub and path dependencies are not registry dependencies and are skipped. A manifest that is not valid TOML has none.
 */
public f<Vector<Dependency>> parseManifestDependencies(const String& manifestText) {
    Vector<Dependency> deps;
    Result<TomlValue*> parsed = parseToml(manifestText);
    if !parsed.isOk() { return deps; }
    TomlValue* root = parsed.unwrap();
    for int pass = 0; pass < 2; pass++ {
        TomlValue* section = root.getFieldOrNil(pass == 0 ? "dependencies" : "dev-dependencies");
        if section == nil<TomlValue*> || !section.isTable() { continue; }
        for unsigned long i = 0l; i < section.getTableSize() && deps.getSize() < 100l; i++ {
            TomlValue* spec = section.getTableValue(i);
            String rawConstraint;
            if spec.isString() {
                rawConstraint = spec.getString();
            } else if spec.isTable() && !spec.hasField("github") && !spec.hasField("path") {
                TomlValue* version = spec.getFieldOrNil("version");
                if version == nil<TomlValue*> || !version.isString() { continue; }
                rawConstraint = version.getString();
            } else {
                continue;
            }
            Dependency dep;
            dep.name = section.getTableKey(i);
            dep.constraint = rawConstraint.trim();
            if dep.constraint.isEmpty() || dep.constraint.getLength() > 64l { dep.constraint = String("*"); }
            dep.dev = pass == 1;
            if !isValidPackageName(dep.name) { continue; }
            bool duplicate = false;
            for unsigned long k = 0l; k < deps.getSize(); k++ {
                if deps.get(k).name == dep.name { duplicate = true; }
            }
            if !duplicate { deps.pushBack(dep); }
        }
    }
    deleteTomlValue(root);
    return deps;
}

/**
 * `description` of the [package] table of a spice.toml manifest, empty if it has none
 */
public f<String> parseManifestDescription(const String& manifestText) {
    String description;
    Result<TomlValue*> parsed = parseToml(manifestText);
    if !parsed.isOk() { return description; }
    TomlValue* root = parsed.unwrap();
    TomlValue* packageTable = root.getFieldOrNil("package");
    if packageTable != nil<TomlValue*> && packageTable.isTable() {
        TomlValue* value = packageTable.getFieldOrNil("description");
        if value != nil<TomlValue*> && value.isString() {
            const String raw = value.getString();
            description = head(raw.trim(), 500l);
        }
    }
    deleteTomlValue(root);
    return description;
}

/**
 * Index of the release that should be the package's latest version: the highest stable one, or if there is none,
 * the highest pre-release. Returns -1 for an empty list.
 */
public f<long> pickLatestRelease(const Vector<Release>& releases) {
    Vector<String> versions;
    for unsigned long i = 0l; i < releases.getSize(); i++ { versions.pushBack(releases.get(i).version); }
    return pickBestVersion(versions, String("*"));
}

// ---------------------------------------------------------------------------------------------------------------------
// Sync batches
// ---------------------------------------------------------------------------------------------------------------------

f<unsigned long> releasesPerPage(const SyncJob& job) {
    return job.path.isEmpty() ? RELEASES_PER_PAGE : SHARED_RELEASES_PER_PAGE;
}

/**
 * Batch 1: repo, readme and releases for every job
 */
public f<String> syncFetchBatch(const Ctx& ctx, const Vector<SyncJob>& jobs) {
    Batch batch;
    for unsigned long i = 0l; i < jobs.getSize(); i++ {
        const SyncJob& job = jobs.get(i);
        const String base = repoApiUrl(job.owner, job.repo);
        const String readmeDir = job.path.isEmpty() ? String("") : String("/") + job.path;
        batch.http("GET", base, String("application/vnd.github+json"), ctx.config.githubApiToken);
        batch.http("GET", base + "/readme" + readmeDir, String("application/vnd.github.html+json"), ctx.config.githubApiToken);
        batch.http("GET", base + "/releases?per_page=" + fmtLong(cast<long>(releasesPerPage(job))), String("application/vnd.github.html+json"), ctx.config.githubApiToken);
    }
    return batch.finish();
}

/**
 * Releases of job `jobIdx`, taken from the fetch batch at handler batch index `fetchBatch`. `complete` tells whether
 * these are all releases of the package, so that versions missing from the list were deleted on GitHub.
 */
public f<Vector<Release>> syncReleasesOf(const Ctx& ctx, int fetchBatch, unsigned long jobIdx, const SyncJob& job, bool& complete) {
    complete = false;
    JV response = ctx.res(fetchBatch, jobIdx * 3l + 2l);
    if response.getNum("status") != 200l {
        Vector<Release> none;
        return none;
    }
    JV body = parseJson(response.getStr("body"));
    const Vector<Release> releases = parseReleases(body, job.owner, job.repo, job.path);
    complete = body.size() < releasesPerPage(job) && releases.getSize() < MAX_RELEASES;
    return releases;
}

/**
 * Batch 2: the manifests of the newest releases of every job
 */
public f<String> syncManifestBatch(const Ctx& ctx, const Vector<SyncJob>& jobs, int fetchBatch) {
    Batch batch;
    for unsigned long i = 0l; i < jobs.getSize(); i++ {
        const SyncJob& job = jobs.get(i);
        bool complete = false;
        const Vector<Release> releases = syncReleasesOf(ctx, fetchBatch, i, job, complete);
        for unsigned long k = 0l; k < releases.getSize() && k < MAX_MANIFESTS; k++ {
            const String url = String("https://raw.githubusercontent.com/") + urlEncode(job.owner) + "/" + urlEncode(job.repo) + "/" +
                               urlEncode(releases.get(k).tag) + "/" + dirPrefix(job.path) + MANIFEST_FILE;
            batch.http("GET", url, String(""), String(""));
        }
    }
    // An empty batch is still a valid batch, the host answers it with an empty result list
    return batch.finish();
}

/**
 * Batch 3: the transaction that stores everything
 */
public f<String> syncWriteBatch(const Ctx& ctx, const Vector<SyncJob>& jobs, int fetchBatch, int manifestBatch) {
    Batch batch;
    batch.tx = true;
    unsigned long manifestIdx = 0l;
    for unsigned long i = 0l; i < jobs.getSize(); i++ {
        const SyncJob& job = jobs.get(i);
        JV repoInfo = ctx.res(fetchBatch, i * 3l);
        JV readme = ctx.res(fetchBatch, i * 3l + 1l);
        bool releasesComplete = false;
        const Vector<Release> releases = syncReleasesOf(ctx, fetchBatch, i, job, releasesComplete);
        JV releasesResponse = ctx.res(fetchBatch, i * 3l + 2l);
        const bool releasesOk = releasesResponse.getNum("status") == 200l;
        const unsigned long manifestCount = releases.getSize() < MAX_MANIFESTS ? releases.getSize() : MAX_MANIFESTS;

        // Package metadata
        {
            Sql sql = Sql("UPDATE packages SET synced_at = ?");
            sql.s(ctx.now);
            if repoInfo.getNum("status") == 200l {
                JV info = parseJson(repoInfo.getStr("body"));
                sql.sql(", stars = ?");
                sql.n(info.getNum("stargazers_count"));
                JV license = info.get("license");
                sql.sql(", license = ?");
                String spdx = license.getStr("spdx_id");
                if spdx == "NOASSERTION" { spdx = String(""); }
                sql.s(head(spdx, 64l));
                // Description and homepage of a repository with several packages describe the repository, not the package
                const String description = info.getStr("description");
                if !description.isEmpty() && job.path.isEmpty() {
                    sql.sql(", description = IF(description = '', ?, description)");
                    sql.s(head(description, 500l));
                }
                const String homepage = info.getStr("homepage");
                if isHttpUrl(homepage) && homepage.getLength() <= 255l && job.path.isEmpty() {
                    sql.sql(", homepage = IF(homepage = '', ?, homepage)");
                    sql.s(homepage);
                }
            }
            const String readmeBody = readme.getStr("body");
            if readme.getNum("status") == 200l && readmeBody.getLength() <= MAX_README_BYTES {
                sql.sql(", readme_html = ?");
                sql.s(rewriteRelativeLinks(readmeBody, job.owner, job.repo, job.path));
            } else if readme.getNum("status") == 404l {
                sql.sql(", readme_html = NULL");
            }
            sql.sql(" WHERE id = ");
            sql.pn(job.packageId);
            batch.query(sql);
        }

        if releasesOk {
            // Mirror what GitHub has: drop versions that no longer exist. That is only known if the list is complete.
            if releasesComplete {
                Sql sql = Sql("DELETE FROM package_versions WHERE package_id = ");
                sql.pn(job.packageId);
                if releases.getSize() > 0l {
                    sql.sql(" AND version NOT IN (");
                    for unsigned long k = 0l; k < releases.getSize(); k++ {
                        if k > 0l { sql.sql(", "); }
                        sql.ps(releases.get(k).version);
                    }
                    sql.sql(")");
                }
                batch.query(sql);
            }
            const unsigned long manifestStart = manifestIdx;
            for unsigned long k = 0l; k < releases.getSize(); k++ {
                const Release& rel = releases.get(k);
                Sql sql = Sql("INSERT INTO package_versions (package_id, version, tag_name, title, changelog, changelog_html, prerelease, tarball_url, published_at) VALUES (");
                sql.pn(job.packageId);
                sql.sql(", ");
                sql.ps(rel.version);
                sql.sql(", ");
                sql.ps(head(rel.tag, 128l));
                sql.sql(", ");
                sql.ps(head(rel.title, 255l));
                sql.sql(", ");
                sql.ps(rel.body);
                sql.sql(", ");
                sql.ps(rel.bodyHtml);
                sql.sql(", ");
                sql.pn(rel.prerelease ? 1l : 0l);
                sql.sql(", ");
                sql.ps(rel.tarballUrl);
                sql.sql(", ");
                sql.ps(rel.publishedAt);
                sql.sql(") ON DUPLICATE KEY UPDATE id = LAST_INSERT_ID(id), tag_name = VALUES(tag_name), title = VALUES(title), " +
                        "changelog = VALUES(changelog), changelog_html = VALUES(changelog_html), prerelease = VALUES(prerelease), " +
                        "tarball_url = VALUES(tarball_url), published_at = VALUES(published_at)");
                batch.query(sql);

                if k < manifestCount {
                    JV manifestResponse = ctx.res(manifestBatch, manifestIdx);
                    manifestIdx++;
                    const long status = manifestResponse.getNum("status");
                    if status == 200l || status == 404l {
                        batch.simple("SET @vid = LAST_INSERT_ID()");
                        batch.simple("DELETE FROM package_dependencies WHERE version_id = @vid");
                        if status == 200l {
                            const Vector<Dependency> deps = parseManifestDependencies(manifestResponse.getStr("body"));
                            for unsigned long d = 0l; d < deps.getSize(); d++ {
                                Sql dep = Sql("INSERT INTO package_dependencies (version_id, dep_name, constraint_text, dev) VALUES (@vid, ");
                                dep.ps(deps.get(d).name);
                                dep.sql(", ");
                                dep.ps(deps.get(d).constraint);
                                dep.sql(", ");
                                dep.pn(deps.get(d).dev ? 1l : 0l);
                                dep.sql(")");
                                batch.query(dep);
                            }
                        }
                    }
                }
            }

            // Point the package at its newest version
            const long latest = pickLatestRelease(releases);
            Sql sql = Sql("UPDATE packages SET latest_version_id = ");
            if latest >= 0l {
                const Release& best = releases.get(cast<unsigned long>(latest));
                sql.sql("(SELECT id FROM package_versions WHERE package_id = ");
                sql.pn(job.packageId);
                sql.sql(" AND version = ");
                sql.ps(best.version);
                sql.sql("), updated_at = ");
                sql.ps(best.publishedAt);
                // A package in a subdirectory takes its description from its manifest instead of the repository
                if !job.path.isEmpty() && cast<unsigned long>(latest) < manifestCount {
                    JV manifestResponse = ctx.res(manifestBatch, manifestStart + cast<unsigned long>(latest));
                    const String description = manifestResponse.getNum("status") == 200l ? parseManifestDescription(manifestResponse.getStr("body")) : String("");
                    if !description.isEmpty() {
                        sql.sql(", description = IF(description = '', ");
                        sql.ps(description);
                        sql.sql(", description)");
                    }
                }
            } else {
                sql.sql("NULL");
            }
            sql.sql(" WHERE id = ");
            sql.pn(job.packageId);
            batch.query(sql);
        } else {
            manifestIdx += manifestCount;
        }
    }
    return batch.finish();
}

// ---------------------------------------------------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------------------------------------------------

#[test]
f<bool> testToDbTime() {
    assert toDbTime(String("2026-10-12T19:43:11Z"), String("x")) == "2026-10-12 19:43:11";
    assert toDbTime(String(""), String("fallback")) == "fallback";
    return true;
}

#[test]
f<bool> testRewriteRelativeLinks() {
    const String html = String("<a href=\"docs/a.md\">a</a><img src=\"/img/x.png\"><a href=\"https://x.org\">x</a><a href=\"#top\">t</a>");
    const String rewritten = rewriteRelativeLinks(html, String("o"), String("r"), String(""));
    assert rewritten == "<a href=\"https://github.com/o/r/blob/HEAD/docs/a.md\">a</a><img src=\"https://raw.githubusercontent.com/o/r/HEAD/img/x.png\">" +
                        String("<a href=\"https://x.org\">x</a><a href=\"#top\">t</a>");
    // In a subdirectory, links start there unless they begin with '/'
    const String nested = rewriteRelativeLinks(html, String("o"), String("r"), String("packages/a"));
    assert nested == "<a href=\"https://github.com/o/r/blob/HEAD/packages/a/docs/a.md\">a</a><img src=\"https://raw.githubusercontent.com/o/r/HEAD/img/x.png\">" +
                     String("<a href=\"https://x.org\">x</a><a href=\"#top\">t</a>");
    return true;
}

#[test]
f<bool> testParseReleases() {
    JV releases = parseJson(String("[{\"tag_name\":\"v1.2.0\",\"name\":\"Big\",\"body\":\"- a\",\"body_html\":\"<ul></ul>\",\"draft\":false,\"prerelease\":false,\"published_at\":\"2026-09-01T10:00:00Z\"}," +
                                   "{\"tag_name\":\"nightly\",\"draft\":false},{\"tag_name\":\"v1.3.0-rc.1\",\"prerelease\":true,\"published_at\":\"2026-10-01T10:00:00Z\"}," +
                                   "{\"tag_name\":\"v1.0.0\",\"draft\":true}]"));
    const Vector<Release> list = parseReleases(releases, String("o"), String("r"), String(""));
    assert list.getSize() == 2l;
    assert list.get(0l).version == "1.2.0";
    assert list.get(0l).bodyHtml == "<ul></ul>";
    assert list.get(0l).publishedAt == "2026-09-01 10:00:00";
    assert list.get(0l).tarballUrl == "https://github.com/o/r/archive/refs/tags/v1.2.0.tar.gz";
    assert list.get(1l).prerelease;
    assert pickLatestRelease(list) == 0l;
    return true;
}

#[test]
f<bool> testReleasesOfSubdirectory() {
    assert tagVersionPart(String("v1.0.0"), String("")) == "v1.0.0";
    assert tagVersionPart(String("github-v1.2.0"), String("packages/github")) == "v1.2.0";
    assert tagVersionPart(String("github/v1.2.0"), String("packages/github")) == "v1.2.0";
    assert tagVersionPart(String("github@1.2.0"), String("packages/github")) == "1.2.0";
    assert tagVersionPart(String("packages/github/v1.2.0"), String("packages/github")) == "v1.2.0";
    assert tagVersionPart(String("v1.2.0"), String("packages/github")) == "";
    assert tagVersionPart(String("github_v1.2.0"), String("packages/github")) == "";
    assert tagVersionPart(String("github-"), String("packages/github")) == "";

    JV releases = parseJson(String("[{\"tag_name\":\"github-actions-v2.0.0\"},{\"tag_name\":\"github-v1.1.0\"},{\"tag_name\":\"v3.0.0\"},") +
                            "{\"tag_name\":\"other/v1.0.0\"},{\"tag_name\":\"packages/github/v1.0.0\"}]");
    const Vector<Release> list = parseReleases(releases, String("o"), String("r"), String("packages/github"));
    assert list.getSize() == 2l;
    assert list.get(0l).version == "1.1.0";
    assert list.get(0l).tarballUrl == "https://github.com/o/r/archive/refs/tags/github-v1.1.0.tar.gz";
    assert list.get(1l).version == "1.0.0";
    assert list.get(1l).tag == "packages/github/v1.0.0";
    return true;
}

#[test]
f<bool> testParseManifest() {
    String manifest = String("# A comment\n[package]\nname = \"x\"\nversion = \"0.1.0\"\n\n");
    manifest += "[dependencies]\n";
    manifest += "json-parser = \"^1.2.0\"  # short form\n";
    manifest += "http-client = { version = \" >=1.0, <2 \" }\n";
    manifest += "http-utils = { github = \"owner/Http-Utils\", rev = \"v1.0.0\" }\n";
    manifest += "my-local = { path = \"../my-local\" }\n";
    manifest += "Bad_Name = \"1\"\n";
    manifest += "\n[dev-dependencies]\ntest-kit = \"~1.2.0\"\njson-parser = \"*\"\n";
    manifest += "\n[tool.some-linter]\nmax-line = 120\n";
    const Vector<Dependency> deps = parseManifestDependencies(manifest);
    assert deps.getSize() == 3l;
    assert deps.get(0l).name == "json-parser";
    assert deps.get(0l).constraint == "^1.2.0";
    assert !deps.get(0l).dev;
    assert deps.get(1l).name == "http-client";
    assert deps.get(1l).constraint == ">=1.0, <2";
    assert deps.get(2l).name == "test-kit";
    assert deps.get(2l).dev;

    // Old JSON manifests and other broken files declare nothing
    const Vector<Dependency> none = parseManifestDependencies(String("{ \"dependencies\": { \"json-parser\": \"^1.2.0\" } }"));
    assert none.getSize() == 0l;

    assert parseManifestDescription(manifest) == "";
    assert parseManifestDescription(String("[package]\nname = \"x\"\ndescription = \" Client for the GitHub REST API \"\n")) == "Client for the GitHub REST API";
    assert parseManifestDescription(String("{}")) == "";
    return true;
}
