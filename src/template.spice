import "std/data/vector";
import "spice_packages/template/template";
import "./util";
import "./json";

// ---------------------------------------------------------------------------------------------------------------------
// Rendering of the templates in templates/ with the template package (spicelang/packages), so the markup lives in
// templates/*.html (icons are .svg) and the Spice code only prepares data.
//
// The host reads the template files once and hands them to the module (see host/templates.mjs). Handlers bind their data
// to a View (database rows and small JSON documents, texts, flags), and a TemplateSet renders a template with it. The
// syntax is the package's Jinja dialect (see its README), with these settings:
//
//   - Indentation is dropped (stripIndentation): whitespace with a line break between two tags (or a tag and a template
//     tag) disappears, so templates can be indented freely. Whitespace between inline elements or words has to stay on
//     one line.
//   - Template names are the file paths below templates/ without the extension: {% include "partials/card" %}.
//   - Rack's own filters: url (also encodes '/', so a value is safe in a path segment), count (12400 -> "12.4k"),
//     thousands, date, datetime, dayshort, isoutc ("2026-10-12 19:43:11" -> "2026-10-12T19:43:11Z", for
//     <time datetime>). They replace built-in filters of the same name (count is length in the package).
//
// Mistakes in a template do not abort the request: the page is replaced by an HTML comment naming the problem, and
// `TemplateSet.errors` reports compile errors and unknown include targets for the host's startup check and the tests.
// ---------------------------------------------------------------------------------------------------------------------

// ---------------------------------------------------------------------------------------------------------------------
// The data of a page
// ---------------------------------------------------------------------------------------------------------------------

/**
 * Convert a node of a parsed JSON document. Whole numbers become integers, other numbers stay text (the templates
 * only print them), missing values are undefined.
 */
public f<TemplateValue> jsonToTemplateValue(JV node) {
    if !node.exists() { return TemplateValue(); }
    const int kind = node.kind();
    if kind == J_NULL { return templateNull(); }
    if kind == J_BOOL { return TemplateValue(node.truthy()); }
    if kind == J_STRING { return TemplateValue(node.str()); }
    if kind == J_NUMBER {
        const String text = node.str();
        const long whole = parseLong(text, 0l);
        if fmtLong(whole) == text { return TemplateValue(whole); }
        return TemplateValue(text);
    }
    if kind == J_ARRAY {
        TemplateValue list = templateList();
        for JV item = node.first(); item.exists(); item = item.after() { list.push(jsonToTemplateValue(item)); }
        return list;
    }
    TemplateValue map = templateMap();
    for JV member = node.first(); member.exists(); member = member.after() {
        map.set(member.keyName(), jsonToTemplateValue(member));
    }
    return map;
}

/**
 * The data a page is rendered with. Handlers bind names to values; templates read them.
 */
public type View struct {
    public TemplateValue data
}

p View.put(string name, const TemplateValue& value) {
    if !this.data.isMap() { this.data = templateMap(); }
    this.data.set(name, value);
}

public p View.bind(string name, JV node) {
    this.put(name, jsonToTemplateValue(node));
}

public p View.text(string name, const String& value) {
    this.put(name, TemplateValue(value));
}

public p View.flag(string name, bool value) {
    this.put(name, TemplateValue(value));
}

/**
 * Bind a list of strings
 */
public p View.list(string name, const Vector<String>& items) {
    TemplateValue list = templateList();
    for unsigned long i = 0l; i < items.getSize(); i++ { list.push(items.get(i)); }
    this.put(name, list);
}

/**
 * Bind a JSON document that was assembled with a JsonWriter
 */
public p View.json(string name, const String& jsonText) {
    this.bind(name, parseJson(jsonText));
}

// ---------------------------------------------------------------------------------------------------------------------
// Rack's filters
// ---------------------------------------------------------------------------------------------------------------------

/**
 * A number from a template value: integers as they are, text parsed (0 if it is not a number)
 */
f<long> templateNumber(const TemplateValue& value) {
    if value.isInt() { return value.asLong(); }
    if value.isBool() { return value.truthy() ? 1l : 0l; }
    return parseLong(value.toString(), 0l);
}

p addRackFilters(TemplateEngine& engine) {
    engine.addFilter("url", f<TemplateValue>(const TemplateValue& value, const TemplateArgs& _) {
        return TemplateValue(urlEncode(value.toString()));
    });
    engine.addFilter("count", f<TemplateValue>(const TemplateValue& value, const TemplateArgs& _) {
        return TemplateValue(fmtCount(templateNumber(value)));
    });
    engine.addFilter("thousands", f<TemplateValue>(const TemplateValue& value, const TemplateArgs& _) {
        return TemplateValue(fmtThousands(templateNumber(value)));
    });
    engine.addFilter("date", f<TemplateValue>(const TemplateValue& value, const TemplateArgs& _) {
        return TemplateValue(fmtDate(value.toString()));
    });
    engine.addFilter("datetime", f<TemplateValue>(const TemplateValue& value, const TemplateArgs& _) {
        return TemplateValue(fmtDateTime(value.toString()));
    });
    engine.addFilter("dayshort", f<TemplateValue>(const TemplateValue& value, const TemplateArgs& _) {
        return TemplateValue(fmtDayShort(value.toString()));
    });
    engine.addFilter("isoutc", f<TemplateValue>(const TemplateValue& value, const TemplateArgs& _) {
        return TemplateValue(fmtIsoUtc(value.toString()));
    });
}

// ---------------------------------------------------------------------------------------------------------------------
// The set of all templates
// ---------------------------------------------------------------------------------------------------------------------

public type TemplateSet struct {
    public TemplateEngine engine
    public bool ready = false
}

p TemplateSet.setUp() {
    if this.ready { return; }
    this.ready = true;
    this.engine.stripIndentation = true;
    addRackFilters(this.engine);
}

f<char> peek(unsigned long address) {
    unsafe {
        byte* bytes = cast<byte*>(address);
        return cast<char>(bytes[0l]);
    }
}

f<String> slice(unsigned long address, unsigned long length) {
    String text;
    unsafe {
        string raw = cast<string>(address);
        text.append(raw, length);
    }
    return text;
}

/**
 * Add the templates of the host's blob: for each template `name\x02length\x03source`, where the length is in bytes
 */
public p TemplateSet.load(unsigned long address, unsigned long size) {
    this.setUp();
    unsigned long pos = 0l;
    while pos < size {
        String name;
        while pos < size && peek(address + pos) != cast<char>(2) {
            name.append(peek(address + pos));
            pos++;
        }
        pos++;
        unsigned long length = 0l;
        while pos < size && peek(address + pos) != cast<char>(3) {
            length = length * 10l + cast<unsigned long>(cast<int>(peek(address + pos)) - 48);
            pos++;
        }
        pos++;
        // Compile errors are reported by errors() and when the template is rendered
        const bool _ = this.engine.add(name, slice(address + pos, length));
        pos += length;
    }
}

/**
 * Same for a blob in a String
 */
public p TemplateSet.load(const String& blob) {
    unsafe { this.load(cast<unsigned long>(blob.getRaw()), blob.getLength()); }
}

/**
 * All problems of all templates, one per line; empty if everything is fine. Also checks that every include with a
 * literal name refers to an existing template.
 */
public f<String> TemplateSet.errors() {
    this.setUp();
    return this.engine.check();
}

/**
 * Render a template. If that fails, the output is an HTML comment with the problem.
 */
public f<String> TemplateSet.render(string name, const View& view) {
    this.setUp();
    const TemplateValue data = view.data.isMap() ? view.data : templateMap();
    Result<String> rendered = this.engine.render(name, data);
    if rendered.isOk() { return rendered.unwrap(); }
    return String("<!-- template error: ") + esc(this.engine.lastError) + " -->";
}

// ---------------------------------------------------------------------------------------------------------------------
// Access to the templates the host provided
// ---------------------------------------------------------------------------------------------------------------------

long TEMPLATES_ADDR = 0l;
long TEMPLATES_SIZE = 0l;

/**
 * The host copies all templates into the wasm memory once and tells the module where they are and how large they are
 */
#[core.compiler.mangle = false]
public p rackSetTemplates(unsigned int ptr, unsigned int size) {
    TEMPLATES_ADDR = cast<long>(ptr);
    TEMPLATES_SIZE = cast<long>(size);
}

public f<TemplateSet> loadHostTemplates() {
    TemplateSet set;
    set.setUp();
    if TEMPLATES_ADDR != 0l { set.load(cast<unsigned long>(TEMPLATES_ADDR), cast<unsigned long>(TEMPLATES_SIZE)); }
    return set;
}

/**
 * Render a template that is not a page, e.g. an XML feed
 */
public f<String> renderTemplate(string name, const View& view) {
    TemplateSet templates = loadHostTemplates();
    return templates.render(name, view);
}

// ---------------------------------------------------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------------------------------------------------

/**
 * One record of the host's template blob
 */
f<String> rec(string name, const String& source) {
    String r;
    r += name;
    r.append(cast<char>(2));
    r += fmtLong(cast<long>(source.getLength()));
    r.append(cast<char>(3));
    r += source;
    return r;
}

f<String> rec(string name, string source) {
    return rec(name, String(source));
}

f<String> demoRender(const String& blob, string name, const View& view) {
    TemplateSet set;
    set.load(blob);
    return set.render(name, view);
}

#[test]
f<bool> testTemplateOutputAndEscaping() {
    View view;
    view.json("user", String("{\"login\":\"a<b>&\\\"'\",\"n\":12345,\"tags\":\"x,y\",\"ratio\":1.5}"));
    view.text("html", String("<b>bold</b>"));
    const String blob = rec("page", "Hi {{ user.login }}|{{{ html }}}|{{ html }}|{{ html|raw }}|{{ user.missing }}|{{ user.n|thousands }}|{{ user.n|count }}|{{ user.ratio }}|{# gone #}.");
    const String out = demoRender(blob, "page", view);
    assert out == "Hi a&lt;b&gt;&amp;&quot;&#39;|<b>bold</b>|&lt;b&gt;bold&lt;/b&gt;|<b>bold</b>||12,345|12.3k|1.5|.";
    return true;
}

#[test]
f<bool> testTemplateFilters() {
    View view;
    view.text("name", String("a b/c"));
    view.text("day", String("2026-09-05 10:11:12"));
    view.text("csv", String("one,two"));
    view.text("big", String("1234567"));
    const String blob = rec("page", "{{ name|prefix:\"v\" }}|{{ day|head:10 }}|{{ name|url }}|{{ day|date }}|{{ day|datetime }}|{{ day|isoutc }}|{{ name|lower }}|{{ big|thousands }}|{{ big|count }}|{% for t in csv|split(\",\") %}[{{ t }}]{% endfor %}");
    const String out = demoRender(blob, "page", view);
    assert out == "va b/c|2026-09-05|a%20b%2Fc|5 Sep 2026|5 Sep 2026, 10:11 UTC|2026-09-05T10:11:12Z|a b/c|1,234,567|1.2M|[one][two]";
    return true;
}

#[test]
f<bool> testTemplateConditions() {
    View view;
    view.flag("yes", true);
    view.flag("no", false);
    view.text("mode", String("b"));
    view.json("list", String("[1]"));
    view.json("none", String("[]"));
    view.json("ids", String("{\"a\":7,\"b\":7,\"zero\":0}"));
    const String blob = rec("page", "{% if no %}A{% elif mode == \"a\" %}B{% elif mode == \"b\" and yes %}C{% else %}D{% endif %}" +
                            String("|{% if not no and yes %}E{% endif %}|{% if no or list %}F{% endif %}|{% if none %}G{% else %}H{% endif %}") +
                            "|{% if mode != \"b\" %}I{% else %}J{% endif %}|{% if mode == \"a or b\" %}K{% else %}L{% endif %}" +
                            "|{% if ids.a == ids.b %}M{% endif %}|{% if ids.zero %}N{% else %}O{% endif %}");
    const String out = demoRender(blob, "page", view);
    assert out == "C|E|F|H|J|L|M|O";
    return true;
}

#[test]
f<bool> testTemplateLoops() {
    View view;
    view.json("rows", String("[{\"n\":\"a\",\"sub\":[1,2]},{\"n\":\"b\",\"sub\":[]}]"));
    view.json("empty", String("[]"));
    Vector<String> items;
    items.pushBack(String("x"));
    items.pushBack(String("y"));
    view.list("items", items);
    const String blob = rec("page", "{% for r in rows %}{{ loop.index }}/{{ loop.length }}{% if loop.first %}^{% endif %}{% if loop.last %}${% endif %}:{{ r.n }}" +
                            String("({% for s in r.sub %}{{ s }}{% if not loop.last %},{% endif %}{% else %}-{% endfor %}) {% endfor %}") +
                            "|{% for r in empty %}x{% else %}nothing{% endfor %}|{% for i in items %}{{ i }}{% endfor %}");
    const String out = demoRender(blob, "page", view);
    assert out == "1/2^:a(1,2) 2/2$:b(-) |nothing|xy";
    return true;
}

#[test]
f<bool> testTemplateIncludes() {
    View view;
    view.json("rows", String("[{\"n\":\"a\"},{\"n\":\"b\"}]"));
    view.text("page", String("inner"));
    view.text("global", String("G"));
    view.json("root", String("{\"n\":\"r\",\"kids\":[{\"n\":\"k1\",\"kids\":[{\"n\":\"leaf\"}]},{\"n\":\"k2\"}]}"));
    String blob = rec("card", "<{{ item.n }}{{ suffix }}{{ global }}{{ r.n }}>");
    blob += rec("inner", "[inner]");
    blob += rec("tree", "{{ node.n }}{% if node.kids %}({% for k in node.kids %}{% include \"tree\" with node=k %}{% endfor %}){% endif %}");
    blob += rec("main", "{% for r in rows %}{% include \"card\" with item=r suffix=\"!\" %}{% endfor %}|{% include page %}|{% include \"tree\" with node=root %}");
    const String out = demoRender(blob, "main", view);
    assert out == "<a!Ga><b!Gb>|[inner]|r(k1(leaf)k2)";
    return true;
}

#[test]
f<bool> testTemplateWhitespace() {
    View view;
    view.text("x", String("1"));
    const String blob = rec("page", "<ul>\n    <li>{{ x }}</li>\n    {% if x %}\n    <li>two</li>\n    {% endif %}\n</ul>\n<b>a</b> <i>b</i>");
    const String out = demoRender(blob, "page", view);
    assert out == "<ul><li>1</li><li>two</li></ul><b>a</b> <i>b</i>";
    return true;
}

#[test]
f<bool> testTemplateErrors() {
    View view;
    TemplateSet set;
    String blob = rec("a", "{% if x %}open");
    blob += rec("b", "{{ x|nope }}");
    blob += rec("c", "{% include \"zzz\" %}");
    blob += rec("d", "{% endfor %}");
    blob += rec("e", "{{ x");
    blob += rec("f", "fine");
    set.load(blob);
    const String report = set.errors();
    assert report.contains("a:");
    assert report.contains("d:");
    assert report.contains("e:");
    assert report.contains("c:1: refers to the unknown template 'zzz'");
    assert !report.contains("f:");
    const String badFilter = set.render("b", view);
    assert badFilter.startsWith("<!-- template error: ");
    assert badFilter.contains("nope");
    const String missing = set.render("missing", view);
    assert missing == "<!-- template error: template &#39;missing&#39; not found -->";
    return true;
}
