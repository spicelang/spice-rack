import "std/data/vector";
import "./util";
import "./json";
import "./semver";
import "./core";
import "./layout";
import "./template";

// ---------------------------------------------------------------------------------------------------------------------
// The public package page: README, versions, dependencies and stats
// ---------------------------------------------------------------------------------------------------------------------

const string TAB_README = "readme";
const string TAB_VERSIONS = "versions";
const string TAB_DEPS = "dependencies";
const string TAB_STATS = "stats";

f<String> activeTab(const Ctx& ctx) {
    const String tab = ctx.query.get("tab");
    if tab == TAB_VERSIONS || tab == TAB_DEPS || tab == TAB_STATS { return tab; }
    return String(TAB_README);
}

// ---------------------------------------------------------------------------------------------------------------------
// Dependency tree
// ---------------------------------------------------------------------------------------------------------------------

public f<String> depTreeSql() {
    return     "WITH RECURSIVE tree AS (" +
    "SELECT 1 AS depth, p.name AS parent, d.dep_name AS dep, d.constraint_text AS constraint_text, d.dev AS dev, CONCAT(',', p.name, ',') AS path " +
    "FROM packages p JOIN package_dependencies d ON d.version_id = p.latest_version_id WHERE p.name = ? AND d.dev = 0 " +
    "UNION ALL " +
    "SELECT t.depth + 1, t.dep, d2.dep_name, d2.constraint_text, d2.dev, CONCAT(t.path, t.dep, ',') " +
    "FROM tree t JOIN packages dp ON dp.name = t.dep JOIN package_dependencies d2 ON d2.version_id = dp.latest_version_id " +
    "WHERE t.depth < 6 AND d2.dev = 0 AND LOCATE(CONCAT(',', d2.dep_name, ','), t.path) = 0) " +
    "SELECT t.depth, t.parent, t.dep, t.constraint_text, t.dev, (dp.id IS NOT NULL) AS in_registry, lv.version AS resolved " +
    "FROM tree t LEFT JOIN packages dp ON dp.name = t.dep LEFT JOIN package_versions lv ON lv.id = dp.latest_version_id " +
    "ORDER BY t.depth, t.parent, t.dep";
}

const long MAX_TREE_NODES = 400l;

/**
 * One level of the tree as JSON for partials/dep-tree.html: all edges that start at `parent`. `depth` is the depth of the
 * edges to write. Every node has its own `children`; once `budget` nodes are written, a "more" marker ends the level.
 */
p writeDepLevel(JsonWriter& w, JV edges, const String& parent, long depth, long& budget) {
    // A level that cannot show anything is left out completely, so its parent renders as a leaf
    if budget <= 0l { return; }
    bool marked = false;
    for JV edge = edges.first(); edge.exists() && !marked; edge = edge.after() {
        if edge.getNum("depth") != depth || edge.getStr("parent") != parent { continue; }
        if budget <= 0l {
            w.beginObject();
            w.kBool("more", true);
            w.endObject();
            marked = true;
            continue;
        }
        budget--;
        const String dep = edge.getStr("dep");
        const String constraint = edge.getStr("constraint_text");
        const String resolved = edge.getStr("resolved");
        const bool inRegistry = edge.getNum("in_registry") == 1l;
        bool satisfied = true;
        if inRegistry && !resolved.isEmpty() {
            const Semver latest = parseSemver(resolved);
            satisfied = latest.valid && satisfies(latest, constraint);
        }
        w.beginObject();
        w.kStr("name", dep);
        w.kStr("constraint", constraint);
        w.kStr("resolved", resolved);
        w.kBool("in_registry", inRegistry);
        w.kBool("mismatch", !satisfied);
        w.kBool("open", depth == 1l);
        w.key("children");
        w.beginArray();
        if inRegistry { writeDepLevel(w, edges, dep, depth + 1l, budget); }
        w.endArray();
        w.endObject();
    }
}

public f<String> depTreeJson(JV edges, const String& root) {
    long budget = MAX_TREE_NODES;
    JsonWriter w;
    w.beginArray();
    writeDepLevel(w, edges, root, 1l, budget);
    w.endArray();
    return w.finish();
}

#[test]
f<bool> testDependencyTree() {
    JV edges = parseJson(String("[{\"depth\":1,\"parent\":\"app\",\"dep\":\"web\",\"constraint_text\":\"^1.0.0\",\"dev\":0,\"in_registry\":1,\"resolved\":\"1.2.0\"}," +
                                "{\"depth\":1,\"parent\":\"app\",\"dep\":\"ghost\",\"constraint_text\":\"*\",\"dev\":0,\"in_registry\":0,\"resolved\":null}," +
                                "{\"depth\":2,\"parent\":\"web\",\"dep\":\"http\",\"constraint_text\":\"^2.0.0\",\"dev\":0,\"in_registry\":1,\"resolved\":\"1.0.0\"}]"));
    const String json = depTreeJson(edges, String("app"));
    JV tree = parseJson(json);
    assert tree.size() == 2l;
    JV web = tree.at(0l);
    assert web.getStr("name") == "web";
    assert web.getBool("open");
    assert !web.getBool("mismatch");
    JV children = web.get("children");
    assert children.size() == 1l;
    JV http = children.at(0l);
    assert http.getStr("name") == "http";
    assert http.getBool("mismatch");
    assert !http.getBool("open");
    JV ghost = tree.at(1l);
    assert !ghost.getBool("in_registry");
    JV ghostChildren = ghost.get("children");
    assert ghostChildren.size() == 0l;
    return true;
}

// ---------------------------------------------------------------------------------------------------------------------
// Handler
// ---------------------------------------------------------------------------------------------------------------------

public f<String> handlePackagePage(Ctx& ctx, const String& name) {
    const String tab = activeTab(ctx);
    if ctx.step() == 0 {
        Batch batch;
        Sql info = Sql("SELECT p.id, p.name, p.description, p.repo_owner, p.repo_name, p.repo_path, p.homepage, p.license, p.stars, p.downloads_total, p.owner_id, p.created_at, p.updated_at, " +
                       String("u.login AS owner_login, lv.version AS latest_version, lv.published_at AS latest_published, ") +
                       "(SELECT GROUP_CONCAT(t.tag ORDER BY t.tag SEPARATOR ',') FROM package_tags t WHERE t.package_id = p.id) AS tags, " +
                       "(SELECT COUNT(DISTINCT dv.package_id) FROM package_dependencies dd JOIN package_versions dv ON dv.id = dd.version_id " +
                       "JOIN packages dp ON dp.latest_version_id = dv.id WHERE dd.dep_name = p.name) AS dependents " +
                       "FROM packages p JOIN users u ON u.id = p.owner_id LEFT JOIN package_versions lv ON lv.id = p.latest_version_id WHERE p.name = ");
        info.ps(name);
        batch.query(info);

        if tab == TAB_README {
            Sql readme = Sql("SELECT readme_html FROM packages WHERE name = ");
            readme.ps(name);
            batch.query(readme);
            if !ctx.isBot() {
                Sql view = Sql("INSERT INTO package_stats_daily (package_id, day, views) SELECT id, UTC_DATE(), 1 FROM packages WHERE name = ");
                view.ps(name);
                view.sql(" ON DUPLICATE KEY UPDATE views = views + 1");
                batch.query(view);
            }
        }
        if tab == TAB_VERSIONS || tab == TAB_STATS {
            Sql versions = Sql("SELECT v.version, v.tag_name, v.title, v.changelog, v.changelog_html, v.prerelease, v.published_at, v.downloads " +
                               String("FROM package_versions v JOIN packages p ON p.id = v.package_id WHERE p.name = "));
            versions.ps(name);
            versions.sql(" ORDER BY v.published_at DESC, v.id DESC");
            batch.query(versions);
        }
        if tab == TAB_DEPS {
            Sql direct = Sql("SELECT d.dep_name, d.constraint_text, d.dev FROM package_dependencies d JOIN packages p ON p.latest_version_id = d.version_id WHERE p.name = ");
            direct.ps(name);
            direct.sql(" ORDER BY d.dev, d.dep_name");
            batch.query(direct);
            Sql tree = Sql(depTreeSql());
            tree.s(name);
            batch.query(tree);
            Sql dependents = Sql("SELECT p2.name FROM package_dependencies d JOIN packages p2 ON p2.latest_version_id = d.version_id WHERE d.dep_name = ");
            dependents.ps(name);
            dependents.sql(" GROUP BY p2.id, p2.name, p2.downloads_total ORDER BY p2.downloads_total DESC, p2.name LIMIT 30");
            batch.query(dependents);
        }
        if tab == TAB_STATS {
            Sql series = Sql("WITH RECURSIVE days AS (SELECT UTC_DATE() - INTERVAL 29 DAY AS day UNION ALL SELECT day + INTERVAL 1 DAY FROM days WHERE day < UTC_DATE()) " +
                             String("SELECT days.day AS day, COALESCE(s.downloads, 0) AS downloads, COALESCE(s.views, 0) AS views FROM days ") +
                             "LEFT JOIN package_stats_daily s ON s.day = days.day AND s.package_id = (SELECT id FROM packages WHERE name = ");
            series.ps(name);
            series.sql(") ORDER BY days.day");
            batch.query(series);
            Sql totals = Sql("SELECT COALESCE(SUM(s.downloads), 0) AS downloads_30d, COALESCE(SUM(s.views), 0) AS views_30d FROM package_stats_daily s " +
                             String("JOIN packages p ON p.id = s.package_id WHERE p.name = "));
            totals.ps(name);
            totals.sql(" AND s.day >= UTC_DATE() - INTERVAL 29 DAY");
            batch.query(totals);
        }
        return batch.finish();
    }

    JV pkgRows = ctx.rows(0, 0l);
    JV pkg = pkgRows.first();
    if !pkg.exists() { return notFound(ctx); }

    View view;
    view.bind("pkg", pkg);
    view.text("name", name);
    view.text("tab", tab);
    const String latest = pkg.getStr("latest_version");

    if tab == TAB_README {
        JV readmeRows = ctx.rows(0, 1l);
        view.bind("readme", readmeRows.first());
        view.text("tab_page", String("package/readme"));
    } else if tab == TAB_VERSIONS {
        view.bind("versions", ctx.rows(0, 1l));
        view.text("tab_page", String("package/versions"));
    } else if tab == TAB_DEPS {
        JV direct = ctx.rows(0, 1l);
        JV edges = ctx.rows(0, 2l);
        bool hasDev = false;
        for JV d = direct.first(); d.exists(); d = d.after() {
            if d.getNum("dev") == 1l { hasDev = true; }
        }
        view.bind("direct", direct);
        view.flag("has_dev", hasDev);
        view.json("tree", depTreeJson(edges, name));
        view.bind("dependents", ctx.rows(0, 3l));
        view.text("tab_page", String("package/dependencies"));
    } else {
        JV versions = ctx.rows(0, 1l);
        JV series = ctx.rows(0, 2l);
        JV totalRows = ctx.rows(0, 3l);
        Vector<String> labels;
        Vector<long> downloads;
        Vector<long> views;
        for JV day = series.first(); day.exists(); day = day.after() {
            labels.pushBack(day.getStr("day"));
            downloads.pushBack(day.getNum("downloads"));
            views.pushBack(day.getNum("views"));
        }
        // The bars of the per-version table are relative to the most downloaded of the shown versions
        long maxDownloads = 1l;
        for JV v = versions.first(); v.exists(); v = v.after() {
            if v.getNum("downloads") > maxDownloads { maxDownloads = v.getNum("downloads"); }
        }
        JsonWriter perVersion;
        perVersion.beginArray();
        unsigned long shown = 0l;
        for JV v = versions.first(); v.exists() && shown < 15l; v = v.after() {
            perVersion.beginObject();
            perVersion.kStr("version", v.getStr("version"));
            perVersion.kStr("published_at", v.getStr("published_at"));
            perVersion.kNum("downloads", v.getNum("downloads"));
            perVersion.kNum("width", v.getNum("downloads") * 100l / maxDownloads);
            perVersion.endObject();
            shown++;
        }
        perVersion.endArray();
        view.bind("totals", totalRows.first());
        view.json("downloads_chart", chartJson(String("Downloads per day (last 30 days)"), labels, downloads, String("downloads")));
        view.json("views_chart", chartJson(String("Page views per day (last 30 days)"), labels, views, String("views")));
        view.json("version_stats", perVersion.finish());
        view.text("tab_page", String("package/stats"));
    }

    view.flag("homepage_ok", isHttpUrl(pkg.getStr("homepage")));
    view.flag("can_manage", ctx.user.present && (ctx.isAdmin() || ctx.user.id == pkg.getNum("owner_id")));

    const String title = name + (latest.isEmpty() ? String("") : String(" ") + latest);
    return ctx.html(200, renderPage(ctx, "pages/package", title, pkg.getStr("description"), view));
}
