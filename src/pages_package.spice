import "std/data/vector";
import "./util";
import "./json";
import "./semver";
import "./core";
import "./layout";

// ---------------------------------------------------------------------------------------------------------------------
// The public package page: README, versions, dependencies and stats
// ---------------------------------------------------------------------------------------------------------------------

const string TAB_README = "readme";
const string TAB_VERSIONS = "versions";
const string TAB_DEPS = "dependencies";
const string TAB_STATS = "stats";

f<String> activeTab(const Ctx& ctx) {
    const String tab = ctx.query.get("tab");
    if tab == TAB_VERSIONS || tab == TAB_DEPS || tab == TAB_STATS { return tab; }
    return String(TAB_README);
}

// ---------------------------------------------------------------------------------------------------------------------
// Dependency tree
// ---------------------------------------------------------------------------------------------------------------------

public f<String> depTreeSql() {
    return     "WITH RECURSIVE tree AS (" +
    "SELECT 1 AS depth, p.name AS parent, d.dep_name AS dep, d.constraint_text AS constraint_text, d.dev AS dev, CONCAT(',', p.name, ',') AS path " +
    "FROM packages p JOIN package_dependencies d ON d.version_id = p.latest_version_id WHERE p.name = ? AND d.dev = 0 " +
    "UNION ALL " +
    "SELECT t.depth + 1, t.dep, d2.dep_name, d2.constraint_text, d2.dev, CONCAT(t.path, t.dep, ',') " +
    "FROM tree t JOIN packages dp ON dp.name = t.dep JOIN package_dependencies d2 ON d2.version_id = dp.latest_version_id " +
    "WHERE t.depth < 6 AND d2.dev = 0 AND LOCATE(CONCAT(',', d2.dep_name, ','), t.path) = 0) " +
    "SELECT t.depth, t.parent, t.dep, t.constraint_text, t.dev, (dp.id IS NOT NULL) AS in_registry, lv.version AS resolved " +
    "FROM tree t LEFT JOIN packages dp ON dp.name = t.dep LEFT JOIN package_versions lv ON lv.id = dp.latest_version_id " +
    "ORDER BY t.depth, t.parent, t.dep";
}

const long MAX_TREE_NODES = 400l;

/**
 * One level of the tree: all edges that start at `parent`. `depth` is the depth of the edges to render.
 */
f<String> renderDepLevel(JV edges, const String& parent, long depth, long& budget) {
    String items;
    unsigned long shown = 0l;
    for JV edge = edges.first(); edge.exists(); edge = edge.after() {
        if edge.getNum("depth") != depth || edge.getStr("parent") != parent { continue; }
        if budget <= 0l { items += "<li class=\"dep-more muted\">&hellip; more dependencies not shown</li>"; break; }
        budget--;
        shown++;
        const String dep = edge.getStr("dep");
        const String constraint = edge.getStr("constraint_text");
        const String resolved = edge.getStr("resolved");
        const bool inRegistry = edge.getNum("in_registry") == 1l;
        bool satisfied = true;
        if inRegistry && !resolved.isEmpty() {
            const Semver latest = parseSemver(resolved);
            satisfied = latest.valid && satisfies(latest, constraint);
        }

        String label = String("<span class=\"dep-name\">");
        if inRegistry { label += "<a href=\"/packages/" + urlEncode(dep) + "\">" + esc(dep) + "</a>"; }
        else { label += esc(dep); }
        label += "</span> <code class=\"dep-constraint\">" + esc(constraint) + "</code>";
        if !inRegistry { label += " <span class=\"badge badge-warn\" title=\"This package is not published on the registry\">not found</span>"; }
        else if !resolved.isEmpty() {
            label += " <span class=\"muted\">&rarr; v" + esc(resolved) + "</span>";
            if !satisfied { label += " <span class=\"badge badge-warn\" title=\"The latest version does not satisfy the constraint\">mismatch</span>"; }
        }

        const String children = inRegistry ? renderDepLevel(edges, dep, depth + 1l, budget) : String("");
        if children.isEmpty() {
            items += "<li class=\"dep-leaf\">" + label + "</li>";
        } else {
            items += String("<li><details") + (depth == 1l ? " open" : "") + "><summary>" + label + "</summary>" + children + "</details></li>";
        }
    }
    if shown == 0l { return String(""); }
    return String("<ul class=\"dep-tree\">") + items + "</ul>";
}

public f<String> renderDependencyTree(JV edges, const String& root) {
    long budget = MAX_TREE_NODES;
    return renderDepLevel(edges, root, 1l, budget);
}

public f<long> countDependencyNodes(JV edges) {
    return cast<long>(edges.size());
}

#[test]
f<bool> testDependencyTree() {
    JV edges = parseJson(String("[{\"depth\":1,\"parent\":\"app\",\"dep\":\"web\",\"constraint_text\":\"^1.0.0\",\"dev\":0,\"in_registry\":1,\"resolved\":\"1.2.0\"}," +
                                "{\"depth\":1,\"parent\":\"app\",\"dep\":\"ghost\",\"constraint_text\":\"*\",\"dev\":0,\"in_registry\":0,\"resolved\":null}," +
                                "{\"depth\":2,\"parent\":\"web\",\"dep\":\"http\",\"constraint_text\":\"^2.0.0\",\"dev\":0,\"in_registry\":1,\"resolved\":\"1.0.0\"}]"));
    const String html = renderDependencyTree(edges, String("app"));
    assert html.contains("<details open>");
    assert html.contains("href=\"/packages/http\"");
    assert html.contains("not found");
    assert html.contains("mismatch");
    return true;
}

// ---------------------------------------------------------------------------------------------------------------------
// Tabs
// ---------------------------------------------------------------------------------------------------------------------

f<String> tabLink(const String& name, const String& label, const String& packageName, const String& active, const String& badge = String("")) {
    String cls = String("tab");
    if name == active { cls += " active"; }
    const String href = String("/packages/") + urlEncode(packageName) + (name == TAB_README ? String("") : String("?tab=") + name);
    String link = String("<a class=\"") + cls + "\" href=\"" + href + "\"" + (name == active ? " aria-current=\"page\"" : "") + ">" + label;
    if !badge.isEmpty() { link += "<span class=\"tab-badge\">" + esc(badge) + "</span>"; }
    return link + "</a>";
}

f<String> renderReadmeTab(JV pkg, JV rows) {
    JV row = rows.first();
    const String html = row.getStr("readme_html");
    if html.isEmpty() {
        String h = String("<div class=\"empty\"><p><strong>No README found.</strong></p><p class=\"muted\">Add a README to the GitHub repository and sync the package to see it here.</p>");
        h += "<p><a class=\"btn\" href=\"https://github.com/" + urlEncode(pkg.getStr("repo_owner")) + "/" + urlEncode(pkg.getStr("repo_name")) + "\" rel=\"noopener\">" + iconGithub() + "View on GitHub</a></p></div>";
        return h;
    }
    // The HTML was rendered and sanitized by GitHub
    return String("<article class=\"readme markdown-body\">") + html + "</article>";
}

f<String> renderVersionsTab(JV pkg, JV versions) {
    if versions.size() == 0l {
        return String("<div class=\"empty\"><p><strong>No releases yet.</strong></p><p class=\"muted\">Publish a GitHub release with a semantic version tag (for example <code>v1.0.0</code>) to make this package installable.</p></div>");
    }
    const String name = pkg.getStr("name");
    String h = String("<ol class=\"versions\">");
    bool first = true;
    for JV v = versions.first(); v.exists(); v = v.after() {
        const String version = v.getStr("version");
        h += "<li class=\"version-item\" id=\"v" + esc(version) + "\"><div class=\"version-head\">";
        h += "<h3>v" + esc(version) + "</h3>";
        if v.getNum("prerelease") == 1l { h += "<span class=\"badge badge-warn\">pre-release</span>"; }
        if version == pkg.getStr("latest_version") { h += "<span class=\"badge badge-ok\">latest</span>"; }
        h += "<span class=\"muted\">" + fmtDate(v.getStr("published_at")) + "</span>";
        h += "<span class=\"spacer\"></span>";
        h += "<span class=\"stat\" title=\"Downloads of this version\">" + iconDownload() + "<span>" + fmtThousands(v.getNum("downloads")) + "</span></span>";
        h += "<a class=\"btn btn-small\" href=\"/api/v1/packages/" + urlEncode(name) + "/versions/" + urlEncode(version) + "/download\">Download</a>";
        h += "</div>";
        const String title = v.getStr("title");
        if !title.isEmpty() && title != "v" + version && title != version { h += "<p class=\"version-title\">" + esc(title) + "</p>"; }
        const String changelogHtml = v.getStr("changelog_html");
        const String changelog = v.getStr("changelog");
        if !changelogHtml.isEmpty() {
            h += String("<details class=\"changelog\"") + (first ? " open" : "") + "><summary>Changelog</summary><div class=\"markdown-body\">" + changelogHtml + "</div></details>";
        } else if !changelog.isEmpty() {
            h += String("<details class=\"changelog\"") + (first ? " open" : "") + "><summary>Changelog</summary><pre>" + esc(changelog) + "</pre></details>";
        } else {
            h += "<p class=\"muted\">No release notes.</p>";
        }
        h += "</li>";
        first = false;
    }
    h += "</ol>";
    return h;
}

f<String> renderDepsTab(JV pkg, JV direct, JV edges, JV dependents) {
    const String name = pkg.getStr("name");
    String h = String("<section class=\"panel\"><h2>Dependency tree</h2>");
    const String latestVersion = pkg.getStr("latest_version");
    if latestVersion.isEmpty() {
        h += "<p class=\"muted\">This package has no release yet, so there are no dependencies to show.</p>";
    } else if direct.size() == 0l {
        h += "<p class=\"muted\">Version " + esc(pkg.getStr("latest_version")) + " has no dependencies.</p>";
    } else {
        h += "<p class=\"muted\">Dependencies of <strong>v" + esc(pkg.getStr("latest_version")) + "</strong>, resolved against the latest versions on this registry. ";
        h += "Click a package to open it; expand a row to see what it needs in turn.</p>";
        const String tree = renderDependencyTree(edges, name);
        h += tree;
        // Development dependencies are listed flat, they are not installed transitively
        String dev;
        for JV d = direct.first(); d.exists(); d = d.after() {
            if d.getNum("dev") != 1l { continue; }
            dev += "<li><a href=\"/packages/" + urlEncode(d.getStr("dep_name")) + "\">" + esc(d.getStr("dep_name")) + "</a> <code class=\"dep-constraint\">" + esc(d.getStr("constraint_text")) + "</code></li>";
        }
        if !dev.isEmpty() { h += "<h3>Development dependencies</h3><ul class=\"plain-list\">" + dev + "</ul>"; }
    }
    h += "</section>";
    h += "<section class=\"panel\"><h2>Used by</h2>";
    if dependents.size() == 0l {
        h += "<p class=\"muted\">No other package on the registry depends on " + esc(name) + " yet.</p>";
    } else {
        h += "<ul class=\"tags\">";
        for JV d = dependents.first(); d.exists(); d = d.after() {
            h += "<li><a class=\"tag\" href=\"/packages/" + urlEncode(d.getStr("name")) + "\">" + esc(d.getStr("name")) + "</a></li>";
        }
        h += "</ul>";
    }
    h += "</section>";
    return h;
}

f<String> renderStatsTab(JV pkg, JV series, JV totals, JV versions) {
    Vector<String> labels;
    Vector<long> downloads;
    Vector<long> views;
    for JV day = series.first(); day.exists(); day = day.after() {
        labels.pushBack(day.getStr("day"));
        downloads.pushBack(day.getNum("downloads"));
        views.pushBack(day.getNum("views"));
    }
    JV t = totals.first();
    String h = String("<div class=\"tiles\">");
    h += "<div class=\"tile\"><span class=\"tile-value\">" + fmtThousands(pkg.getNum("downloads_total")) + "</span><span class=\"tile-label\">Downloads, all time</span></div>";
    h += "<div class=\"tile\"><span class=\"tile-value\">" + fmtThousands(t.getNum("downloads_30d")) + "</span><span class=\"tile-label\">Downloads, last 30 days</span></div>";
    h += "<div class=\"tile\"><span class=\"tile-value\">" + fmtThousands(t.getNum("views_30d")) + "</span><span class=\"tile-label\">Page views, last 30 days</span></div>";
    h += "<div class=\"tile\"><span class=\"tile-value\">" + fmtThousands(pkg.getNum("dependents")) + "</span><span class=\"tile-label\">Packages depending on it</span></div>";
    h += "<div class=\"tile\"><span class=\"tile-value\">" + fmtThousands(pkg.getNum("stars")) + "</span><span class=\"tile-label\">GitHub stars</span></div>";
    h += "</div>";
    h += "<section class=\"panel\">" + barChart(String("Downloads per day (last 30 days)"), labels, downloads, String("downloads")) + "</section>";
    h += "<section class=\"panel\">" + barChart(String("Page views per day (last 30 days)"), labels, views, String("views")) + "</section>";
    h += "<section class=\"panel\"><h2>Downloads by version</h2>";
    if versions.size() == 0l {
        h += "<p class=\"muted\">No releases yet.</p>";
    } else {
        long maxDownloads = 1l;
        for JV v = versions.first(); v.exists(); v = v.after() {
            if v.getNum("downloads") > maxDownloads { maxDownloads = v.getNum("downloads"); }
        }
        h += "<table class=\"table\"><thead><tr><th>Version</th><th>Released</th><th class=\"num\">Downloads</th><th class=\"bar-cell\"></th></tr></thead><tbody>";
        unsigned long shown = 0l;
        for JV v = versions.first(); v.exists() && shown < 15l; v = v.after() {
            const long count = v.getNum("downloads");
            h += "<tr><td><a href=\"/packages/" + urlEncode(pkg.getStr("name")) + "?tab=versions#v" + esc(v.getStr("version")) + "\">v" + esc(v.getStr("version")) + "</a></td>";
            h += "<td>" + fmtDate(v.getStr("published_at")) + "</td><td class=\"num\">" + fmtThousands(count) + "</td>";
            h += "<td class=\"bar-cell\"><span class=\"inline-bar\" style=\"width:" + fmtLong(count * 100l / maxDownloads) + "%\"></span></td></tr>";
            shown++;
        }
        h += "</tbody></table>";
    }
    h += "</section>";
    h += "<p class=\"muted small\">Downloads are counted when a version archive is fetched through the registry API. Page views exclude well-known bots.</p>";
    return h;
}

f<String> renderSidebar(const Ctx& ctx, JV pkg) {
    const String name = pkg.getStr("name");
    const String version = pkg.getStr("latest_version");
    const String repoUrl = String("https://github.com/") + urlEncode(pkg.getStr("repo_owner")) + "/" + urlEncode(pkg.getStr("repo_name"));
    String h = String("<aside class=\"sidebar\">");
    if !version.isEmpty() {
        h += "<section class=\"side-block\"><h2>Use this package</h2>";
        h += "<p class=\"muted small\">Add it to the <code>dependencies</code> of your <code>spice.json</code>:</p>";
        const Semver parsed = parseSemver(version);
        h += "<pre class=\"code\"><code>\"" + esc(name) + "\": \"^" + esc(parsed.valid ? fmtLong(parsed.major) + "." + fmtLong(parsed.minor) + "." + fmtLong(parsed.patch) : version) + "\"</code></pre>";
        h += "<p><a class=\"btn btn-block\" href=\"/api/v1/packages/" + urlEncode(name) + "/versions/" + urlEncode(version) + "/download\">" + iconDownload() + "Download v" + esc(version) + "</a></p></section>";
    }
    h += "<section class=\"side-block\"><h2>About</h2><dl class=\"facts\">";
    if !version.isEmpty() { h += "<dt>Latest version</dt><dd>v" + esc(version) + "</dd><dt>Published</dt><dd>" + fmtDate(pkg.getStr("latest_published")) + "</dd>"; }
    h += "<dt>Downloads</dt><dd>" + fmtThousands(pkg.getNum("downloads_total")) + "</dd>";
    h += "<dt>GitHub stars</dt><dd>" + fmtThousands(pkg.getNum("stars")) + "</dd>";
    const String license = pkg.getStr("license");
    if !license.isEmpty() { h += "<dt>License</dt><dd>" + esc(license) + "</dd>"; }
    h += "<dt>Maintainer</dt><dd><a href=\"/packages?owner=" + urlEncode(pkg.getStr("owner_login")) + "\">" + esc(pkg.getStr("owner_login")) + "</a></dd>";
    h += "<dt>Registered</dt><dd>" + fmtDate(pkg.getStr("created_at")) + "</dd>";
    h += "</dl></section>";
    h += "<section class=\"side-block\"><h2>Links</h2><ul class=\"plain-list\">";
    h += "<li><a href=\"" + esc(repoUrl) + "\" rel=\"noopener\">" + iconGithub() + "Repository</a></li>";
    const String homepage = pkg.getStr("homepage");
    if isHttpUrl(homepage) { h += "<li><a href=\"" + esc(homepage) + "\" rel=\"noopener nofollow\">Homepage</a></li>"; }
    h += "<li><a href=\"" + esc(repoUrl) + "/issues\" rel=\"noopener\">Issues</a></li>";
    h += "<li><a href=\"/api/v1/packages/" + urlEncode(name) + "\">JSON metadata</a></li>";
    h += "</ul></section>";
    if ctx.user.present && (ctx.isAdmin() || ctx.user.id == pkg.getNum("owner_id")) {
        h += "<section class=\"side-block\"><a class=\"btn btn-block\" href=\"/dashboard/packages/" + urlEncode(name) + "\">Manage package</a></section>";
    }
    h += "</aside>";
    return h;
}

// ---------------------------------------------------------------------------------------------------------------------
// Handler
// ---------------------------------------------------------------------------------------------------------------------

public f<String> handlePackagePage(Ctx& ctx, const String& name) {
    const String tab = activeTab(ctx);
    if ctx.step() == 0 {
        Batch batch;
        Sql info = Sql("SELECT p.id, p.name, p.description, p.repo_owner, p.repo_name, p.homepage, p.license, p.stars, p.downloads_total, p.owner_id, p.created_at, p.updated_at, " +
                       String("u.login AS owner_login, lv.version AS latest_version, lv.published_at AS latest_published, ") +
                       "(SELECT GROUP_CONCAT(t.tag ORDER BY t.tag SEPARATOR ',') FROM package_tags t WHERE t.package_id = p.id) AS tags, " +
                       "(SELECT COUNT(DISTINCT dv.package_id) FROM package_dependencies dd JOIN package_versions dv ON dv.id = dd.version_id " +
                       "JOIN packages dp ON dp.latest_version_id = dv.id WHERE dd.dep_name = p.name) AS dependents " +
                       "FROM packages p JOIN users u ON u.id = p.owner_id LEFT JOIN package_versions lv ON lv.id = p.latest_version_id WHERE p.name = ");
        info.ps(name);
        batch.query(info);

        if tab == TAB_README {
            Sql readme = Sql("SELECT readme_html FROM packages WHERE name = ");
            readme.ps(name);
            batch.query(readme);
            if !ctx.isBot() {
                Sql view = Sql("INSERT INTO package_stats_daily (package_id, day, views) SELECT id, UTC_DATE(), 1 FROM packages WHERE name = ");
                view.ps(name);
                view.sql(" ON DUPLICATE KEY UPDATE views = views + 1");
                batch.query(view);
            }
        }
        if tab == TAB_VERSIONS || tab == TAB_STATS {
            Sql versions = Sql("SELECT v.version, v.tag_name, v.title, v.changelog, v.changelog_html, v.prerelease, v.published_at, v.downloads " +
                               String("FROM package_versions v JOIN packages p ON p.id = v.package_id WHERE p.name = "));
            versions.ps(name);
            versions.sql(" ORDER BY v.published_at DESC, v.id DESC");
            batch.query(versions);
        }
        if tab == TAB_DEPS {
            Sql direct = Sql("SELECT d.dep_name, d.constraint_text, d.dev FROM package_dependencies d JOIN packages p ON p.latest_version_id = d.version_id WHERE p.name = ");
            direct.ps(name);
            direct.sql(" ORDER BY d.dev, d.dep_name");
            batch.query(direct);
            Sql tree = Sql(depTreeSql());
            tree.s(name);
            batch.query(tree);
            Sql dependents = Sql("SELECT p2.name FROM package_dependencies d JOIN packages p2 ON p2.latest_version_id = d.version_id WHERE d.dep_name = ");
            dependents.ps(name);
            dependents.sql(" GROUP BY p2.id, p2.name, p2.downloads_total ORDER BY p2.downloads_total DESC, p2.name LIMIT 30");
            batch.query(dependents);
        }
        if tab == TAB_STATS {
            Sql series = Sql("WITH RECURSIVE days AS (SELECT UTC_DATE() - INTERVAL 29 DAY AS day UNION ALL SELECT day + INTERVAL 1 DAY FROM days WHERE day < UTC_DATE()) " +
                             String("SELECT days.day AS day, COALESCE(s.downloads, 0) AS downloads, COALESCE(s.views, 0) AS views FROM days ") +
                             "LEFT JOIN package_stats_daily s ON s.day = days.day AND s.package_id = (SELECT id FROM packages WHERE name = ");
            series.ps(name);
            series.sql(") ORDER BY days.day");
            batch.query(series);
            Sql totals = Sql("SELECT COALESCE(SUM(s.downloads), 0) AS downloads_30d, COALESCE(SUM(s.views), 0) AS views_30d FROM package_stats_daily s " +
                             String("JOIN packages p ON p.id = s.package_id WHERE p.name = "));
            totals.ps(name);
            totals.sql(" AND s.day >= UTC_DATE() - INTERVAL 29 DAY");
            batch.query(totals);
        }
        return batch.finish();
    }

    JV pkgRows = ctx.rows(0, 0l);
    JV pkg = pkgRows.first();
    if !pkg.exists() { return notFound(ctx); }

    String content = String("<div class=\"package-header\"><div class=\"container\">");
    content += "<div class=\"title-row\"><h1>" + esc(name) + "</h1>";
    const String latest = pkg.getStr("latest_version");
    if !latest.isEmpty() { content += "<span class=\"version big\">v" + esc(latest) + "</span>"; }
    content += "</div><p class=\"lead\">" + esc(pkg.getStr("description")) + "</p>";
    content += tagList(pkg.getStr("tags"));
    content += "<nav class=\"tabs\" aria-label=\"Package sections\">";
    content += tabLink(String(TAB_README), String("Readme"), name, tab);
    content += tabLink(String(TAB_VERSIONS), String("Versions"), name, tab);
    content += tabLink(String(TAB_DEPS), String("Dependencies"), name, tab);
    content += tabLink(String(TAB_STATS), String("Stats"), name, tab);
    content += "</nav></div></div>";

    content += "<div class=\"container package-layout\"><div class=\"package-main\">";
    if tab == TAB_README {
        JV readmeRows = ctx.rows(0, 1l);
        content += renderReadmeTab(pkg, readmeRows);
    } else if tab == TAB_VERSIONS {
        JV versions = ctx.rows(0, 1l);
        content += renderVersionsTab(pkg, versions);
    } else if tab == TAB_DEPS {
        JV direct = ctx.rows(0, 1l);
        JV edges = ctx.rows(0, 2l);
        JV dependents = ctx.rows(0, 3l);
        content += renderDepsTab(pkg, direct, edges, dependents);
    } else {
        JV versions = ctx.rows(0, 1l);
        JV series = ctx.rows(0, 2l);
        JV totals = ctx.rows(0, 3l);
        content += renderStatsTab(pkg, series, totals, versions);
    }
    content += "</div>" + renderSidebar(ctx, pkg) + "</div>";

    const String title = name + (latest.isEmpty() ? String("") : String(" ") + latest);
    return ctx.html(200, layoutPage(ctx, title, pkg.getStr("description"), content));
}
