import "std/data/vector";
import "./util";
import "./json";
import "./core";
import "./template";

// ---------------------------------------------------------------------------------------------------------------------
// Page shell. The markup of every page lives in templates/ (see template.spice); this file prepares what the shell of
// each page needs (user, menu, notices) and offers the data helpers of the shared components. The whole UI is rendered
// on the server without any client-side script.
// ---------------------------------------------------------------------------------------------------------------------

public const string SITE_NAME = "Spice Rack";

// ---------------------------------------------------------------------------------------------------------------------
// Rendering
// ---------------------------------------------------------------------------------------------------------------------

/**
 * Translate the notice codes of the query string to messages. Free text from the URL is never reflected.
 * Returns the JSON for the template (`kind` is a CSS class), or an empty string if there is nothing to show.
 */
f<String> noticeJson(const Ctx& ctx) {
    const String notice = ctx.query.get("notice");
    const String error = ctx.query.get("error");
    String message;
    String kind = String("notice-ok");
    if notice == "created" { message = String("Package created. The first sync with GitHub is complete."); }
    else if notice == "saved" { message = String("Changes saved."); }
    else if notice == "synced" { message = String("Synced with GitHub."); }
    else if notice == "deleted" { message = String("Package deleted."); }
    else if notice == "signedout" { message = String("You have been signed out."); }
    else if notice == "userdeleted" { message = String("User deleted."); }
    else if error == "denied" { message = String("GitHub sign-in was cancelled or denied."); kind = String("notice-err"); }
    else if error == "state" { message = String("The sign-in request expired. Please try again."); kind = String("notice-err"); }
    else if error == "suspended" { message = String("This account is suspended."); kind = String("notice-err"); }
    else if error == "github" { message = String("GitHub could not be reached. Please try again in a moment."); kind = String("notice-err"); }
    if message.isEmpty() { return String(""); }
    JsonWriter w;
    w.beginObject();
    w.kStr("kind", kind);
    w.kStr("message", message);
    w.endObject();
    return w.finish();
}

/**
 * What the shell of every page needs besides the page's own data: the signed-in user, the active menu entry, a notice
 */
p bindShell(const Ctx& ctx, View& view) {
    view.text("site_name", String(SITE_NAME));
    view.text("csrf", ctx.user.csrf);

    JsonWriter user;
    user.beginObject();
    user.kBool("present", ctx.user.present);
    user.kNum("id", ctx.user.id);
    user.kStr("login", ctx.user.login);
    user.kStr("role", ctx.user.role);
    user.kBool("admin", ctx.isAdmin());
    user.endObject();
    view.json("user", user.finish());

    JsonWriter nav;
    nav.beginObject();
    nav.kBool("packages", ctx.path.startsWith("/packages"));
    nav.kBool("docs", ctx.path.startsWith("/docs"));
    nav.kBool("dashboard", ctx.path.startsWith("/dashboard"));
    nav.kBool("admin", ctx.path.startsWith("/admin"));
    nav.endObject();
    view.json("nav", nav.finish());

    const String notice = noticeJson(ctx);
    if !notice.isEmpty() { view.json("notice", notice); }
}

/**
 * Render a page template inside the layout. `page` is the name of the template (see templates/pages), `view` holds
 * the data the page was prepared with.
 */
public f<String> renderPage(const Ctx& ctx, string page, const String& title, const String& description, View& view) {
    bindShell(ctx, view);
    view.text("page", String(page));
    view.text("title", title);
    view.text("description", description);
    TemplateSet templates = loadHostTemplates();
    return templates.render("layout", view);
}

public f<String> errorPageHtml(const Ctx& ctx, int status, const String& heading, const String& text) {
    View view;
    view.text("code", fmtLong(cast<long>(status)));
    view.text("heading", heading);
    view.text("text", text);
    return renderPage(ctx, "pages/error", heading, text, view);
}

public f<String> notFound(Ctx& ctx) {
    return ctx.html(404, errorPageHtml(ctx, 404, String("Page not found"), String("The page you are looking for does not exist, or has been moved.")));
}

public f<String> forbidden(Ctx& ctx) {
    return ctx.html(403, errorPageHtml(ctx, 403, String("Not allowed"), String("You do not have permission to do that.")));
}

public f<String> badRequest(Ctx& ctx, const String& text) {
    return ctx.html(400, errorPageHtml(ctx, 400, String("Bad request"), text));
}

public f<String> serverError(Ctx& ctx) {
    return ctx.html(500, errorPageHtml(ctx, 500, String("Something went wrong"), String("The server hit an unexpected problem. Please try again in a moment.")));
}

/**
 * Anonymous visitors are sent to the GitHub sign-in
 */
public f<String> requireLogin(Ctx& ctx) {
    // Remember where to continue after the login, if the path is plain enough to be stored in a cookie
    bool plain = ctx.path.getLength() < 150l;
    for unsigned long i = 0l; i < ctx.path.getLength() && plain; i++ {
        const char c = ctx.path[i];
        plain = isLowerAlnum(c) || (c >= 'A' && c <= 'Z') || c == '/' || c == '-' || c == '_' || c == '.';
    }
    if plain { ctx.setCookie("rack_return", ctx.path, 600l); }
    return ctx.redirect(String("/auth/github"));
}

/**
 * Whether GitHub rejected the token of the session because it was revoked or has expired. Only once within a few minutes,
 * so a token GitHub keeps rejecting ends in an error message instead of a redirect loop.
 */
public f<bool> githubTokenRejected(Ctx& ctx, JV response) {
    const String renewed = ctx.cookie("rack_renew");
    return response.getNum("status") == 401l && renewed.isEmpty();
}

/**
 * Ends the session whose GitHub token was rejected and sends the visitor to the sign-in, which brings a fresh token.
 * Deleting the session takes one step of the handler, `deleted` says whether it ran.
 */
public f<String> renewLogin(Ctx& ctx, bool deleted) {
    if !deleted {
        Batch batch;
        Sql sql = Sql("DELETE FROM sessions WHERE id = ");
        sql.ps(ctx.cookie(SESSION_COOKIE));
        batch.query(sql);
        return batch.finish();
    }
    ctx.setCookie(SESSION_COOKIE, String(""), 0l);
    ctx.setCookie("rack_renew", String("1"), 300l);
    return requireLogin(ctx);
}

// ---------------------------------------------------------------------------------------------------------------------
// Components
// ---------------------------------------------------------------------------------------------------------------------

/**
 * Data for partials/pagination.html. `baseQuery` is the already encoded query string without the page parameter.
 */
public f<String> paginationJson(const String& basePath, const String& baseQuery, long page, long pageCount) {
    const String prefix = basePath + "?" + baseQuery + (baseQuery.isEmpty() ? "" : "&") + "page=";
    JsonWriter w;
    w.beginObject();
    w.kBool("show", pageCount > 1l);
    w.kStr("prev", page > 1l ? prefix + fmtLong(page - 1l) : String(""));
    w.kStr("next", page < pageCount ? prefix + fmtLong(page + 1l) : String(""));
    w.kNum("page", page);
    w.kNum("pages", pageCount);
    w.endObject();
    return w.finish();
}

/**
 * Data for partials/bar-chart.html: the geometry of an SVG bar chart. `labels` and `values` have the same length.
 */
public f<String> chartJson(const String& title, const Vector<String>& labels, const Vector<long>& values, const String& unit) {
    const long width = 720l;
    const long height = 200l;
    const long left = 44l;
    const long right = 8l;
    const long top = 12l;
    const long bottom = 26l;
    const unsigned long count = values.getSize();
    long maxValue = 1l;
    long total = 0l;
    for unsigned long i = 0l; i < count; i++ {
        if values.get(i) > maxValue { maxValue = values.get(i); }
        total += values.get(i);
    }
    // Pick a "nice" step (1, 2, 5, 10, 20, 50, ...) so that four steps cover the maximum
    long step = 1l;
    while step * 4l < maxValue {
        long leading = step;
        while leading >= 10l { leading /= 10l; }
        if leading == 2l { step = step * 5l / 2l; } else { step = step * 2l; }
    }
    const long axisMax = step * 4l;

    const long plotW = width - left - right;
    const long plotH = height - top - bottom;
    JsonWriter w;
    w.beginObject();
    w.kStr("title", title);
    w.kStr("total", fmtThousands(total));
    w.kStr("viewBox", String("0 0 ") + fmtLong(width) + " " + fmtLong(height));
    // Grid lines with the labels of the y axis
    w.key("grid");
    w.beginArray();
    for long g = 0l; g <= 4l; g++ {
        const long y = top + plotH - (plotH * g / 4l);
        w.beginObject();
        w.kNum("x1", left);
        w.kNum("x2", width - right);
        w.kNum("y", y);
        w.kNum("labelX", left - 6l);
        w.kNum("labelY", y + 4l);
        w.kStr("label", fmtCount(step * g));
        w.endObject();
    }
    w.endArray();
    w.key("bars");
    w.beginArray();
    if count > 0l {
        const long slot = plotW * 100l / cast<long>(count);
        for unsigned long i = 0l; i < count; i++ {
            const long value = values.get(i);
            const long barH = value * plotH / axisMax;
            const long x = left + (cast<long>(i) * slot) / 100l;
            const long barW = (slot * 72l) / 10000l > 1l ? (slot * 72l) / 10000l : 1l;
            const long y = top + plotH - barH;
            w.beginObject();
            w.kNum("x", x + (slot / 100l - barW) / 2l);
            w.kNum("y", y);
            w.kNum("width", barW);
            w.kNum("height", barH > 0l ? barH : 0l);
            w.kStr("tip", labels.get(i) + ": " + fmtThousands(value) + " " + unit);
            // Only every fifth bar (and the last) gets a label on the x axis
            const bool labelled = i % 5l == 0l || i + 1l == count;
            w.kStr("axis", labelled ? fmtDayShort(labels.get(i)) : String(""));
            w.kNum("axisX", x + slot / 200l);
            w.kNum("axisY", height - 8l);
            w.endObject();
        }
    }
    w.endArray();
    w.endObject();
    return w.finish();
}

#[test]
f<bool> testChartJson() {
    Vector<String> labels;
    Vector<long> values;
    for long i = 0l; i < 30l; i++ {
        labels.pushBack(String("2026-09-") + (i < 9l ? "0" : "") + fmtLong(i + 1l));
        values.pushBack(i * 3l);
    }
    JV chart = parseJson(chartJson(String("Downloads"), labels, values, String("downloads")));
    assert chart.getStr("title") == "Downloads";
    assert chart.getStr("total") == "1,305";
    JV grid = chart.get("grid");
    assert grid.size() == 5l;
    JV bars = chart.get("bars");
    assert bars.size() == 30l;
    JV last = bars.at(29l);
    assert last.getStr("tip") == "2026-09-30: 87 downloads";
    assert last.getStr("axis") == "30 Sep";
    JV second = bars.at(1l);
    assert second.getStr("axis") == "";
    return true;
}

#[test]
f<bool> testPaginationJson() {
    JV middle = parseJson(paginationJson(String("/packages"), String("q=json&sort=name"), 2l, 5l));
    assert middle.getBool("show");
    assert middle.getStr("prev") == "/packages?q=json&sort=name&page=1";
    assert middle.getStr("next") == "/packages?q=json&sort=name&page=3";
    JV single = parseJson(paginationJson(String("/admin/users"), String(""), 1l, 1l));
    assert !single.getBool("show");
    JV first = parseJson(paginationJson(String("/admin/users"), String(""), 1l, 3l));
    assert first.getStr("prev") == "";
    assert first.getStr("next") == "/admin/users?page=2";
    return true;
}
