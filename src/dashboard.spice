import "std/data/vector";
import "./util";
import "./json";
import "./core";
import "./layout";
import "./github";

// ---------------------------------------------------------------------------------------------------------------------
// Maintainer area: dashboard, creating packages and managing them.
// The package forms are shared with the admin area, which has a few extra fields (name, repository, maintainer).
// ---------------------------------------------------------------------------------------------------------------------

public f<String> formField(const String& label, const String& name, const String& value, const String& hint, bool required = false, bool readonly = false, const String& placeholder = String("")) {
    String h = String("<div class=\"field\"><label for=\"f-") + name + "\">" + esc(label) + (required ? " <span class=\"req\" title=\"required\">*</span>" : "") + "</label>";
    h += "<input id=\"f-" + name + "\" name=\"" + name + "\" type=\"text\" value=\"" + esc(value) + "\"" + (required ? " required" : "") + (readonly ? " readonly" : "");
    h += placeholder.isEmpty() ? String("") : String(" placeholder=\"") + esc(placeholder) + "\"";
    h += " autocomplete=\"off\">";
    if !hint.isEmpty() { h += "<p class=\"hint\">" + esc(hint) + "</p>"; }
    return h + "</div>";
}

public f<String> errorList(const Vector<String>& errors) {
    if errors.getSize() == 0l { return String(""); }
    String h = String("<div class=\"notice notice-err\" role=\"alert\"><ul>");
    for unsigned long i = 0l; i < errors.getSize(); i++ { h += "<li>" + esc(errors.get(i)) + "</li>"; }
    return h + "</ul></div>";
}

// ---------------------------------------------------------------------------------------------------------------------
// Dashboard
// ---------------------------------------------------------------------------------------------------------------------

public f<String> handleDashboard(Ctx& ctx) {
    if !ctx.user.present { return requireLogin(ctx); }
    if ctx.step() == 0 {
        Batch batch;
        Sql packages = Sql("SELECT p.name, p.description, p.downloads_total, p.stars, p.updated_at, p.synced_at, lv.version AS latest_version, " +
                           String("COALESCE(s.d30, 0) AS d30, COALESCE(s.v30, 0) AS v30 FROM packages p LEFT JOIN package_versions lv ON lv.id = p.latest_version_id ") +
                           "LEFT JOIN (SELECT package_id, SUM(downloads) AS d30, SUM(views) AS v30 FROM package_stats_daily WHERE day >= UTC_DATE() - INTERVAL 29 DAY GROUP BY package_id) s ON s.package_id = p.id " +
                           "WHERE p.owner_id = ");
        packages.pn(ctx.user.id);
        packages.sql(" ORDER BY p.name");
        batch.query(packages);
        Sql series = Sql("WITH RECURSIVE days AS (SELECT UTC_DATE() - INTERVAL 29 DAY AS day UNION ALL SELECT day + INTERVAL 1 DAY FROM days WHERE day < UTC_DATE()) " +
                         String("SELECT days.day AS day, COALESCE(x.downloads, 0) AS downloads FROM days LEFT JOIN (SELECT s.day, SUM(s.downloads) AS downloads FROM package_stats_daily s ") +
                         "JOIN packages p ON p.id = s.package_id WHERE p.owner_id = ");
        series.pn(ctx.user.id);
        series.sql(" GROUP BY s.day) x ON x.day = days.day ORDER BY days.day");
        batch.query(series);
        return batch.finish();
    }
    JV packages = ctx.rows(0, 0l);
    JV series = ctx.rows(0, 1l);
    long totalDownloads = 0l;
    long downloads30 = 0l;
    for JV pk = packages.first(); pk.exists(); pk = pk.after() {
        totalDownloads += pk.getNum("downloads_total");
        downloads30 += pk.getNum("d30");
    }
    Vector<String> labels;
    Vector<long> values;
    for JV day = series.first(); day.exists(); day = day.after() {
        labels.pushBack(day.getStr("day"));
        values.pushBack(day.getNum("downloads"));
    }

    String h = String("<div class=\"page-title\"><div class=\"container title-flex\"><div><h1>Dashboard</h1><p class=\"muted\">Signed in as <strong>");
    h += esc(ctx.user.login) + "</strong> &middot; " + esc(ctx.user.role) + "</p></div>";
    h += "<a class=\"btn btn-primary\" href=\"/dashboard/packages/new\">New package</a></div></div>";
    h += "<div class=\"container section\"><div class=\"tiles\">";
    h += "<div class=\"tile\"><span class=\"tile-value\">" + fmtThousands(cast<long>(packages.size())) + "</span><span class=\"tile-label\">Packages</span></div>";
    h += "<div class=\"tile\"><span class=\"tile-value\">" + fmtThousands(totalDownloads) + "</span><span class=\"tile-label\">Downloads, all time</span></div>";
    h += "<div class=\"tile\"><span class=\"tile-value\">" + fmtThousands(downloads30) + "</span><span class=\"tile-label\">Downloads, last 30 days</span></div></div>";
    if packages.size() == 0l {
        h += "<div class=\"empty\"><p><strong>You have not published a package yet.</strong></p>";
        h += "<p class=\"muted\">Tag a release on GitHub, then add the repository to the registry.</p>";
        h += "<p><a class=\"btn btn-primary\" href=\"/dashboard/packages/new\">Create your first package</a> <a class=\"btn\" href=\"/docs/publishing\">Publishing guide</a></p></div>";
    } else {
        h += "<section class=\"panel\">" + barChart(String("Downloads of your packages (last 30 days)"), labels, values, String("downloads")) + "</section>";
        h += "<section class=\"panel\"><h2>Your packages</h2><div class=\"table-wrap\"><table class=\"table\"><thead><tr><th>Package</th><th>Latest</th><th class=\"num\">Downloads</th><th class=\"num\">30 days</th><th class=\"num\">Views (30d)</th><th>Last sync</th><th></th></tr></thead><tbody>";
        for JV pk = packages.first(); pk.exists(); pk = pk.after() {
            const String name = pk.getStr("name");
            const String version = pk.getStr("latest_version");
            h += "<tr><td><a href=\"/packages/" + urlEncode(name) + "\"><strong>" + esc(name) + "</strong></a><div class=\"muted small\">" + esc(pk.getStr("description")) + "</div></td>";
            h += "<td>" + (version.isEmpty() ? String("&ndash;") : "v" + esc(version)) + "</td>";
            h += "<td class=\"num\">" + fmtThousands(pk.getNum("downloads_total")) + "</td><td class=\"num\">" + fmtThousands(pk.getNum("d30")) + "</td><td class=\"num\">" + fmtThousands(pk.getNum("v30")) + "</td>";
            const String synced = pk.getStr("synced_at");
            h += "<td>" + (synced.isEmpty() ? String("never") : fmtDate(synced)) + "</td>";
            h += "<td class=\"actions\"><a class=\"btn btn-small\" href=\"/dashboard/packages/" + urlEncode(name) + "\">Manage</a></td></tr>";
        }
        h += "</tbody></table></div></section>";
    }
    h += "</div>";
    return ctx.html(200, layoutPage(ctx, String("Dashboard"), String("Manage your Spice packages."), h));
}

// ---------------------------------------------------------------------------------------------------------------------
// Create package
// ---------------------------------------------------------------------------------------------------------------------

f<String> area(bool adminMode) { return adminMode ? String("/admin/packages") : String("/dashboard/packages"); }

/**
 * Split "owner/repo" (also accepts a github.com URL) into its parts. Returns false if it is not valid.
 */
public f<bool> parseRepoRef(const String& input, String& owner, String& repo) {
    String text = input.trim();
    if text.startsWith("https://github.com/") { text = tail(text, 19l); }
    else if text.startsWith("http://github.com/") { text = tail(text, 18l); }
    else if text.startsWith("github.com/") { text = tail(text, 11l); }
    while text.endsWith("/") { text = head(text, text.getLength() - 1l); }
    if text.endsWith(".git") { text = head(text, text.getLength() - 4l); }
    const Vector<String> parts = split(text, '/');
    if parts.getSize() != 2l { return false; }
    if !isValidGithubName(parts.get(0l)) || !isValidGithubName(parts.get(1l)) { return false; }
    owner = parts.get(0l);
    repo = parts.get(1l);
    return true;
}

f<String> suggestName(const String& repo) {
    String name = lower(repo);
    String cleaned;
    for unsigned long i = 0l; i < name.getLength(); i++ {
        const char c = name[i];
        cleaned.append(isLowerAlnum(c) || c == '-' || c == '_' || c == '.' ? c : '-');
    }
    return cleaned;
}

f<String> renderCreateForm(const Ctx& ctx, bool adminMode, JV repos, JV taken, const Vector<String>& errors) {
    String h = String("<div class=\"page-title\"><div class=\"container\"><h1>New package</h1><p class=\"muted\">Register a GitHub repository as a package. Releases with semantic version tags become its versions.</p></div></div>");
    h += "<div class=\"container narrow section\">" + errorList(errors);
    h += "<form class=\"form panel\" method=\"post\" action=\"" + area(adminMode) + "/new\">" + csrfField(ctx);

    if !adminMode {
        h += "<div class=\"field\"><label for=\"f-repo-select\">Your repositories</label><select id=\"f-repo-select\" name=\"repo_select\"><option value=\"\">Choose a repository&hellip;</option>";
        for JV r = repos.first(); r.exists(); r = r.after() {
            const String full = r.getStr("full_name");
            bool isTaken = false;
            for JV t = taken.first(); t.exists(); t = t.after() {
                if lower(t.getStr("repo_owner") + "/" + t.getStr("repo_name")) == lower(full) { isTaken = true; }
            }
            if isTaken || r.getBool("fork") || r.getBool("archived") { continue; }
            h += String("<option value=\"") + esc(full) + "\"" + (ctx.form.get("repo_select") == full ? " selected" : "") + ">" + esc(full) + "</option>";
        }
        h += "</select><p class=\"hint\">Public, non-fork, non-archived repositories you own that are not yet on the registry.</p></div>";
    }
    h += formField(String(adminMode ? "Repository" : "Or enter a repository manually"), String("repo"), ctx.form.get("repo"),
                   String("owner/name, e.g. spicelang/spice. You need push access to it") , adminMode, false, String("owner/name"));
    if adminMode {
        h += formField(String("Maintainer (GitHub login)"), String("maintainer"), ctx.form.get("maintainer"), String("The user must have signed in to the registry before."), true);
    }
    h += formField(String("Package name"), String("name"), ctx.form.get("name"), String("Lowercase letters, digits, - _ and . (2-64 characters). Leave empty to use the repository name."));
    h += formField(String("Description"), String("description"), ctx.form.get("description"), String("One short sentence. Leave empty to use the GitHub description."));
    h += formField(String("Tags"), String("tags"), ctx.form.get("tags"), String("Comma separated, up to 8, e.g. json, parser, web"));
    h += formField(String("Homepage"), String("homepage"), ctx.form.get("homepage"), String("Optional. Defaults to the homepage from GitHub."));
    h += "<div class=\"form-actions\"><button class=\"btn btn-primary\" type=\"submit\">Create package</button><a class=\"btn btn-ghost\" href=\"" + String(adminMode ? "/admin/packages" : "/dashboard") + "\">Cancel</a></div></form></div>";
    return layoutPage(ctx, String("New package"), String("Create a package"), h);
}

/**
 * GET/POST for /dashboard/packages/new and /admin/packages/new
 *   GET  step 0: load the user's repositories
 *   POST step 0: verify repository and names    step 1: insert    step 2-4: first sync    step 5: redirect
 */
public f<String> handleCreatePackage(Ctx& ctx, bool adminMode) {
    if !ctx.user.present { return requireLogin(ctx); }
    if adminMode && !ctx.isAdmin() { return forbidden(ctx); }
    const int step = ctx.step();
    Vector<String> errors;

    if !ctx.isPost() {
        if step == 0 {
            if adminMode {
                JV none = missingJson();
                return ctx.html(200, renderCreateForm(ctx, true, none, none, errors));
            }
            Batch batch;
            batch.http("GET", String(GITHUB_API) + "/users/" + urlEncode(ctx.user.login) + "/repos?per_page=100&sort=pushed&type=owner", String("application/vnd.github+json"), ctx.user.token);
            Sql taken = Sql("SELECT repo_owner, repo_name FROM packages WHERE repo_owner = ");
            taken.ps(ctx.user.login);
            batch.query(taken);
            return batch.finish();
        }
        JV response = ctx.res(0, 0l);
        JV repos = parseJson(response.getStr("body"));
        JV taken = ctx.rows(0, 1l);
        return ctx.html(200, renderCreateForm(ctx, false, repos, taken, errors));
    }

    // POST
    if !ctx.csrfOk() { return forbidden(ctx); }
    String owner;
    String repo;
    String repoInput = ctx.form.get("repo");
    const String repoTrimmed = trimmed(repoInput);
    if repoTrimmed.isEmpty() { repoInput = ctx.form.get("repo_select"); }
    String name = lower(ctx.formTrim("name"));
    const bool repoValid = parseRepoRef(repoInput, owner, repo);
    if !repoValid { errors.pushBack(String("Please choose a repository or enter it as owner/name.")); }
    if name.isEmpty() && repoValid { name = suggestName(repo); }
    if repoValid && !isValidPackageName(name) { errors.pushBack(String("The package name must have 2-64 characters: lowercase letters, digits, '-', '_' and '.', starting with a letter or digit.")); }
    const String homepage = ctx.formTrim("homepage");
    if !homepage.isEmpty() && (!isHttpUrl(homepage) || homepage.getLength() > 255l) { errors.pushBack(String("The homepage must be an http(s) URL.")); }
    const String description = head(ctx.formTrim("description"), 500l);
    const Vector<String> tags = parseTags(ctx.form.get("tags"));
    const String maintainer = ctx.formTrim("maintainer");
    if adminMode && maintainer.isEmpty() { errors.pushBack(String("Please enter the GitHub login of the maintainer.")); }

    if errors.getSize() > 0l {
        JV none = missingJson();
        return ctx.html(400, renderCreateForm(ctx, adminMode, none, none, errors));
    }

    if step == 0 {
        Batch batch;
        batch.http("GET", repoApiUrl(owner, repo), String("application/vnd.github+json"), adminMode ? ctx.config.githubApiToken : ctx.user.token);
        Sql dup = Sql("SELECT name, repo_owner, repo_name FROM packages WHERE name = ");
        dup.ps(name);
        dup.sql(" OR (repo_owner = ");
        dup.ps(owner);
        dup.sql(" AND repo_name = ");
        dup.ps(repo);
        dup.sql(")");
        batch.query(dup);
        Sql target = Sql("SELECT id FROM users WHERE login = ");
        target.ps(adminMode ? maintainer : ctx.user.login);
        batch.query(target);
        return batch.finish();
    }

    JV repoResponse = ctx.res(0, 0l);
    JV repoInfo = parseJson(repoResponse.getStr("body"));
    JV duplicates = ctx.rows(0, 1l);
    JV targetRows = ctx.rows(0, 2l);
    JV targetUser = targetRows.first();
    JV permissions = repoInfo.get("permissions");
    if repoResponse.getNum("status") == 404l { errors.pushBack(String("GitHub does not know this repository, or it is private.")); }
    else if repoResponse.getNum("status") != 200l { errors.pushBack(String("GitHub could not be reached. Please try again in a moment.")); }
    else if !adminMode && !permissions.getBool("push") && !permissions.getBool("admin") { errors.pushBack(String("You need push access to this repository to publish it.")); }
    if duplicates.size() > 0l { errors.pushBack(String("A package with this name, or for this repository, already exists.")); }
    if !targetUser.exists() { errors.pushBack(String("The maintainer has not signed in to the registry yet.")); }
    if errors.getSize() > 0l {
        JV none = missingJson();
        return ctx.html(409, renderCreateForm(ctx, adminMode, none, none, errors));
    }

    // Canonical spelling of owner and repository, as GitHub has it
    JV ownerNode = repoInfo.get("owner");
    const String githubOwner = ownerNode.getStr("login");
    const String githubRepo = repoInfo.getStr("name");
    const String realOwner = githubOwner.isEmpty() ? owner : githubOwner;
    const String realRepo = githubRepo.isEmpty() ? repo : githubRepo;

    if step == 1 {
        Batch batch;
        batch.tx = true;
        JV license = repoInfo.get("license");
        String spdx = license.getStr("spdx_id");
        if spdx == "NOASSERTION" { spdx = String(""); }
        String finalDescription = description.isEmpty() ? head(repoInfo.getStr("description"), 500l) : description;
        String finalHomepage = homepage.isEmpty() ? repoInfo.getStr("homepage") : homepage;
        if !isHttpUrl(finalHomepage) || finalHomepage.getLength() > 255l { finalHomepage = String(""); }
        Sql insert = Sql("INSERT INTO packages (name, description, repo_owner, repo_name, homepage, license, stars, owner_id, created_at, updated_at) VALUES (");
        insert.ps(name);
        insert.sql(", ");
        insert.ps(finalDescription);
        insert.sql(", ");
        insert.ps(realOwner);
        insert.sql(", ");
        insert.ps(realRepo);
        insert.sql(", ");
        insert.ps(finalHomepage);
        insert.sql(", ");
        insert.ps(head(spdx, 64l));
        insert.sql(", ");
        insert.pn(repoInfo.getNum("stargazers_count"));
        insert.sql(", ");
        insert.pn(targetUser.getNum("id"));
        insert.sql(", ");
        insert.ps(ctx.now);
        insert.sql(", ");
        insert.ps(ctx.now);
        insert.sql(")");
        batch.query(insert);
        batch.simple("SET @pid = LAST_INSERT_ID()");
        for unsigned long i = 0l; i < tags.getSize(); i++ {
            Sql tag = Sql("INSERT INTO package_tags (package_id, tag) VALUES (@pid, ");
            tag.ps(tags.get(i));
            tag.sql(")");
            batch.query(tag);
        }
        batch.simple("SELECT @pid AS id");
        return batch.finish();
    }

    if ctx.failed(1, 0l) {
        errors.pushBack(String("A package with this name, or for this repository, already exists."));
        JV none = missingJson();
        return ctx.html(409, renderCreateForm(ctx, adminMode, none, none, errors));
    }
    JV idRows = ctx.rows(1, tags.getSize() + 2l);
    JV idRow = idRows.first();
    SyncJob job;
    job.packageId = idRow.getNum("id");
    job.owner = realOwner;
    job.repo = realRepo;
    Vector<SyncJob> jobs;
    jobs.pushBack(job);
    if step == 2 { return syncFetchBatch(ctx, jobs); }
    if step == 3 { return syncManifestBatch(ctx, jobs, 2); }
    if step == 4 { return syncWriteBatch(ctx, jobs, 2, 3); }
    return ctx.redirect(withNotice(String("/packages/") + urlEncode(name), "created"));
}

// ---------------------------------------------------------------------------------------------------------------------
// Manage package
// ---------------------------------------------------------------------------------------------------------------------

f<String> renderManageForm(const Ctx& ctx, bool adminMode, JV pkg, const Vector<String>& errors) {
    const String name = pkg.getStr("name");
    const bool posted = ctx.isPost() && ctx.form.get("action") == "save";
    const String description = posted ? ctx.form.get("description") : pkg.getStr("description");
    const String homepage = posted ? ctx.form.get("homepage") : pkg.getStr("homepage");
    const String tags = posted ? ctx.form.get("tags") : pkg.getStr("tags");
    const String base = area(adminMode) + "/" + urlEncode(name);

    String h = String("<div class=\"page-title\"><div class=\"container title-flex\"><div><h1>Manage ") + esc(name) + "</h1>";
    h += "<p class=\"muted\">Maintained by " + esc(pkg.getStr("owner_login")) + " &middot; repository " + esc(pkg.getStr("repo_owner")) + "/" + esc(pkg.getStr("repo_name")) + "</p></div>";
    h += "<a class=\"btn\" href=\"/packages/" + urlEncode(name) + "\">View public page</a></div></div>";
    h += "<div class=\"container narrow section\">" + errorList(errors);

    h += "<form class=\"form panel\" method=\"post\" action=\"" + base + "\">" + csrfField(ctx) + "<input type=\"hidden\" name=\"action\" value=\"save\"><h2>Details</h2>";
    if adminMode {
        h += formField(String("Package name"), String("name"), posted ? ctx.form.get("name") : name, String("Renaming breaks existing references to the package."), true);
        h += formField(String("Repository"), String("repo"), posted ? ctx.form.get("repo") : pkg.getStr("repo_owner") + "/" + pkg.getStr("repo_name"), String("owner/name"), true);
        h += formField(String("Maintainer (GitHub login)"), String("maintainer"), posted ? ctx.form.get("maintainer") : pkg.getStr("owner_login"), String(""), true);
    } else {
        h += formField(String("Package name"), String("name"), name, String("The name cannot be changed. Ask an administrator if you need a different one."), false, true);
    }
    h += formField(String("Description"), String("description"), description, String("One short sentence."));
    h += formField(String("Tags"), String("tags"), tags, String("Comma separated, up to 8."));
    h += formField(String("Homepage"), String("homepage"), homepage, String("Optional http(s) URL."));
    h += "<div class=\"form-actions\"><button class=\"btn btn-primary\" type=\"submit\">Save changes</button></div></form>";

    h += "<section class=\"panel\"><h2>Sync with GitHub</h2><p class=\"muted\">README, releases and dependencies are refreshed automatically. Use this after publishing a release. Last sync: ";
    const String synced = pkg.getStr("synced_at");
    h += (synced.isEmpty() ? String("never") : fmtDateTime(synced)) + ".</p>";
    h += "<form method=\"post\" action=\"" + base + "\">" + csrfField(ctx) + "<input type=\"hidden\" name=\"action\" value=\"sync\"><button class=\"btn\" type=\"submit\">Sync now</button></form></section>";

    h += "<section class=\"panel danger-zone\"><h2>Delete package</h2><p class=\"muted\">This removes the package, all of its versions and its statistics from the registry. Your GitHub repository is not touched. This cannot be undone.</p>";
    h += "<form class=\"form\" method=\"post\" action=\"" + base + "\">" + csrfField(ctx) + "<input type=\"hidden\" name=\"action\" value=\"delete\">";
    h += formField(String("Type the package name to confirm"), String("confirm"), String(""), String(""), true, false, name);
    h += "<div class=\"form-actions\"><button class=\"btn btn-danger\" type=\"submit\">Delete this package</button></div></form></section></div>";
    return layoutPage(ctx, String("Manage ") + name, String("Manage a package"), h);
}

/**
 * GET/POST for /dashboard/packages/{name} and /admin/packages/{name}
 */
public f<String> handleManagePackage(Ctx& ctx, const String& name, bool adminMode) {
    if !ctx.user.present { return requireLogin(ctx); }
    if adminMode && !ctx.isAdmin() { return forbidden(ctx); }
    const int step = ctx.step();

    if step == 0 {
        Batch batch;
        Sql sql = Sql("SELECT p.id, p.name, p.description, p.repo_owner, p.repo_name, p.homepage, p.owner_id, p.synced_at, u.login AS owner_login, " +
                      String("(SELECT GROUP_CONCAT(t.tag ORDER BY t.tag SEPARATOR ', ') FROM package_tags t WHERE t.package_id = p.id) AS tags ") +
                      "FROM packages p JOIN users u ON u.id = p.owner_id WHERE p.name = ");
        sql.ps(name);
        batch.query(sql);
        return batch.finish();
    }
    JV pkgRows = ctx.rows(0, 0l);
    JV pkg = pkgRows.first();
    if !pkg.exists() { return notFound(ctx); }
    if !ctx.isAdmin() && pkg.getNum("owner_id") != ctx.user.id { return notFound(ctx); }

    Vector<String> errors;
    if !ctx.isPost() { return ctx.html(200, renderManageForm(ctx, adminMode, pkg, errors)); }
    if !ctx.csrfOk() { return forbidden(ctx); }
    const String action = ctx.form.get("action");
    const long packageId = pkg.getNum("id");

    if action == "sync" {
        SyncJob job;
        job.packageId = packageId;
        job.owner = pkg.getStr("repo_owner");
        job.repo = pkg.getStr("repo_name");
        Vector<SyncJob> jobs;
        jobs.pushBack(job);
        if step == 1 { return syncFetchBatch(ctx, jobs); }
        if step == 2 { return syncManifestBatch(ctx, jobs, 1); }
        if step == 3 { return syncWriteBatch(ctx, jobs, 1, 2); }
        return ctx.redirect(withNotice(area(adminMode) + "/" + urlEncode(name), "synced"));
    }

    if action == "delete" {
        if ctx.formTrim("confirm") != name {
            errors.pushBack(String("The confirmation did not match the package name."));
            return ctx.html(400, renderManageForm(ctx, adminMode, pkg, errors));
        }
        if step == 1 {
            Batch batch;
            Sql sql = Sql("DELETE FROM packages WHERE id = ");
            sql.pn(packageId);
            batch.query(sql);
            return batch.finish();
        }
        return ctx.redirect(withNotice(String(adminMode ? "/admin/packages" : "/dashboard"), "deleted"));
    }

    if action == "save" {
        const String description = head(ctx.formTrim("description"), 500l);
        const String homepage = ctx.formTrim("homepage");
        const Vector<String> tags = parseTags(ctx.form.get("tags"));
        String newName = name;
        String newOwner;
        String newRepo;
        String maintainer = ctx.formTrim("maintainer");
        if !homepage.isEmpty() && (!isHttpUrl(homepage) || homepage.getLength() > 255l) { errors.pushBack(String("The homepage must be an http(s) URL.")); }
        if adminMode {
            newName = lower(ctx.formTrim("name"));
            if !isValidPackageName(newName) { errors.pushBack(String("Invalid package name.")); }
            if !parseRepoRef(ctx.form.get("repo"), newOwner, newRepo) { errors.pushBack(String("Please enter the repository as owner/name.")); }
            if maintainer.isEmpty() { errors.pushBack(String("Please enter the maintainer's GitHub login.")); }
        }
        if errors.getSize() > 0l { return ctx.html(400, renderManageForm(ctx, adminMode, pkg, errors)); }

        if step == 1 {
            Batch batch;
            batch.tx = true;
            Sql update = Sql("UPDATE packages SET description = ");
            update.ps(description);
            update.sql(", homepage = ");
            update.ps(homepage);
            update.sql(", updated_at = updated_at");
            if adminMode {
                update.sql(", name = ");
                update.ps(newName);
                update.sql(", repo_owner = ");
                update.ps(newOwner);
                update.sql(", repo_name = ");
                update.ps(newRepo);
                update.sql(", owner_id = (SELECT id FROM users WHERE login = ");
                update.ps(maintainer);
                update.sql(")");
            }
            update.sql(" WHERE id = ");
            update.pn(packageId);
            batch.query(update);
            Sql clear = Sql("DELETE FROM package_tags WHERE package_id = ");
            clear.pn(packageId);
            batch.query(clear);
            for unsigned long i = 0l; i < tags.getSize(); i++ {
                Sql tag = Sql("INSERT INTO package_tags (package_id, tag) VALUES (");
                tag.pn(packageId);
                tag.sql(", ");
                tag.ps(tags.get(i));
                tag.sql(")");
                batch.query(tag);
            }
            return batch.finish();
        }
        if ctx.failed(1, 0l) {
            const String code = ctx.errorCode(1, 0l);
            errors.pushBack(code == "ER_DUP_ENTRY" ? String("That name or repository is already used by another package.") :
                            (code == "ER_BAD_NULL_ERROR" ? String("The maintainer has not signed in to the registry yet.") : String("The package could not be saved.")));
            return ctx.html(409, renderManageForm(ctx, adminMode, pkg, errors));
        }
        return ctx.redirect(withNotice(area(adminMode) + "/" + urlEncode(newName), "saved"));
    }

    return badRequest(ctx, String("Unknown action."));
}

#[test]
f<bool> testParseRepoRef() {
    String owner;
    String repo;
    assert parseRepoRef(String("spicelang/spice"), owner, repo) && owner == "spicelang" && repo == "spice";
    assert parseRepoRef(String(" https://github.com/foo/bar.git/ "), owner, repo) && owner == "foo" && repo == "bar";
    assert !parseRepoRef(String("foo"), owner, repo);
    assert !parseRepoRef(String("foo/bar/baz"), owner, repo);
    assert !parseRepoRef(String("foo/ba r"), owner, repo);
    assert suggestName(String("My_Repo!")) == "my_repo-";
    return true;
}
